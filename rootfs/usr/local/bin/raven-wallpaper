#!/bin/sh
# Paint the desktop background from ~/.config/raven. The session's own setting
# (wallpaper.local.*) wins over the host-wide one copied in by raven (wallpaper.*).
# Settings files are "key=value" lines: type=image|color, mode=<xwallpaper mode>, color=<X color>.
set -u
dir=$HOME/.config/raven
mkdir -p "$dir"

# The entrypoint and raven can run this at the same moment; whoever runs last reads the newest files
exec 9>"$dir/.wallpaper.lock"
flock 9

get() { sed -n "s/^$2=//p" "$1" | head -n 1; }

usable() {
    [ -f "$1" ] || return 1
    case "$(get "$1" type)" in
        color) [ -n "$(get "$1" color)" ] ;;
        image)
            case "$(get "$1" mode)" in
                zoom | maximize | center | tile | stretch | focus) [ -s "${1%.conf}.img" ] ;;
                *) return 1 ;;
            esac ;;
        *) return 1 ;;
    esac
}

conf=
for c in "$dir/wallpaper.local.conf" "$dir/wallpaper.conf"; do
    usable "$c" && { conf=$c; break; }
done

# Skip repainting when these exact files are already on screen; the root property
# disappears with the X server, so a restarted session always paints
if [ -n "$conf" ]; then
    key="$conf $(cksum < "$conf")"
    [ "$(get "$conf" type)" != image ] || key="$key $(cksum < "${conf%.conf}.img")"
else
    key=none
fi
current=$(xprop -root -notype _RAVEN_WALLPAPER 2>/dev/null | sed -n 's/^_RAVEN_WALLPAPER = "\(.*\)"$/\1/p')
if [ "$key" = "$current" ]; then
    [ -n "$conf" ] && [ "$(get "$conf" type)" = image ] || exit 0
    pgrep -u "$(id -u)" -x xwallpaper >/dev/null && exit 0
fi

pkill -u "$(id -u)" -x xwallpaper 2>/dev/null
if [ -z "$conf" ]; then
    xsetroot -solid black
elif [ "$(get "$conf" type)" = color ]; then
    xsetroot -solid "$(get "$conf" color)"
else
    # --daemon repaints when the screen size changes (viewer resize); it must not keep the lock.
    # --no-atoms: xwallpaper 0.7.3 (Ubuntu 24.04) updating the root pixmap atoms kills its own
    # X connection on the first resize when no earlier root pixmap existed (fixed upstream by
    # "Kill clients only once"), leaving the background at the size of that resize.
    xwallpaper --daemon --no-atoms "--$(get "$conf" mode)" "${conf%.conf}.img" 9>&-
fi
xprop -root -f _RAVEN_WALLPAPER 8s -set _RAVEN_WALLPAPER "$key"
