#!/bin/sh
# Start the tint2 taskbar once per session. A session's own ~/.config/tint2/tint2rc
# wins; otherwise read the image default for this window manager with -c, so tint2
# does not copy it into the session home and image updates apply.
pgrep -u "$(id -u)" -x tint2 >/dev/null && exit 0
rc=${XDG_CONFIG_HOME:-$HOME/.config}/tint2/tint2rc
if [ ! -f "$rc" ]; then
    case "${RAVEN_WM:-openbox}" in
        xmonad) rc=/etc/raven/tint2/xmonad.tint2rc ;;
        *) rc=/etc/xdg/tint2/tint2rc ;;
    esac
    # Addon buttons (/etc/raven/panel.d/*.tint2rc) go after the default config.
    # Each P in panel_items shows the next button, so add one P per button before the clock.
    set -- /etc/raven/panel.d/*.tint2rc
    if [ -f "$1" ]; then
        p=$(cat "$@" | grep -c '^button = new')
        p=$(printf "%${p}s" '' | tr ' ' P)
        { sed "/^panel_items = /{ /C/ s/C/${p}C/; /C/! s/\$/$p/; }" "$rc"; cat "$@"; } > /tmp/raven-tint2rc
        rc=/tmp/raven-tint2rc
    fi
fi
exec tint2 -c "$rc"
