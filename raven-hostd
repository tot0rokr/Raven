#!/usr/bin/env python3
"""Host relay: lets a raven session start the host entries of the host's menu.conf.

A session connects to the abstract socket @raven-host-<host uid> (containers share
the host network namespace) and sends "<session id> <label>". Session users have
their own uid, so the peer is identified by the container it runs in: only a process
inside this user's container of that session is served. Only a label crosses the
boundary: the command is looked up on the host by `raven run -t <id> @<label>` in the
"LABEL = @COMMAND" rules of the host's ~/.config/raven/menu.conf.

usage: raven-hostd RAVEN_CLI
"""
import os
import pwd
import re
import socket
import socketserver
import struct
import subprocess
import sys

RAVEN = sys.argv[1]
ADDRESS = "\0raven-host-%d" % os.getuid()
# The raven.user label, made like the CLI does from the login name
USER = re.sub(r"[^A-Za-z0-9_.-]", "_", pwd.getpwuid(os.getuid()).pw_name)
UCRED = struct.Struct("3i")
REQUEST = re.compile(r"(\d+) ([^\x00-\x1f\x7f]{1,200})")
CONTAINER = re.compile(r"/docker-([0-9a-f]{64})\.scope$|/docker/([0-9a-f]{64})$", re.M)


def session_of(pid):
    """Session id of the container that process pid runs in, if it is one of this user's."""
    try:
        with open("/proc/%d/cgroup" % pid) as f:
            m = CONTAINER.search(f.read())
    except OSError:
        return None
    if not m:
        return None
    r = subprocess.run(["docker", "inspect", "-f",
                        '{{index .Config.Labels "raven.user"}} {{index .Config.Labels "raven.id"}}',
                        m.group(1) or m.group(2)], capture_output=True, text=True)
    owner, _, sid = r.stdout.strip().partition(" ")
    return sid if r.returncode == 0 and owner == USER else None


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        cred = self.request.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, UCRED.size)
        pid, _, _ = UCRED.unpack(cred)
        m = REQUEST.fullmatch(self.rfile.readline(1024).decode(errors="replace").strip())
        if not m:
            return self.reply("error: bad request")
        if session_of(pid) != m.group(1):
            return self.reply("error: permission denied")
        r = subprocess.run([RAVEN, "run", "-t", m.group(1), "@" + m.group(2)],
                           capture_output=True, text=True)
        err = r.stderr.strip().removeprefix("raven: ")
        self.reply("ok" if r.returncode == 0 else "error: " + (err or "failed"))

    def reply(self, msg):
        self.wfile.write((msg + "\n").encode())


def main():
    try:
        server = socketserver.UnixStreamServer(ADDRESS, Handler)
    except OSError:
        return  # another relay already owns the socket
    server.serve_forever()


if __name__ == "__main__":
    main()
