#!/bin/sh
# tmux-like persistent X desktops: Xvnc sessions in Docker, viewed over X11 or HTTPS.
set -eu

self=$(readlink -f "$0")
srcdir=$(dirname "$self")
# Separate tags let a worktree build and run its own image beside the main one
image=${RAVEN_IMAGE:-raven:latest}
core_image=${RAVEN_CORE_IMAGE:-raven-core:latest}
user=$(id -un | tr -c 'A-Za-z0-9_.\n-' '_')
confdir=${XDG_CONFIG_HOME:-$HOME/.config}/raven
statedir=${XDG_STATE_HOME:-$HOME/.local/state}/raven/$(hostname)
rundir=${XDG_RUNTIME_DIR:-/tmp}/raven-$(id -u)
backupdir=${XDG_DATA_HOME:-$HOME/.local/share}/raven/backups
display_base=100
port_base=15900
default_cmd=xterm
default_geometry=1600x900
default_addons=edge
default_wm=${RAVEN_WM:-xmonad}
default_memory=2g
default_cpus=2
session_pids=512
# A running session's memory limit is never set closer than this to what it uses now
memory_headroom=$((64 * 1048576))
memory_floor=$((512 * 1048576))
# The unit tests point these at a fake /proc and cgroup tree
proc_root=${RAVEN_TEST_PROC:-/proc}
cgroup_root=${RAVEN_TEST_CGROUP:-/sys/fs/cgroup}

usage() {
    cat <<'EOF'
usage: raven [new] [-d] [-s NAME] [-g WxH] [-w WM] [-m SIZE] [-c CPUS] [CMD...]   create a session and attach (default)
       raven attach|a [-d] [-g WxH] [TARGET]           attach to a session
       raven ls                                        list sessions
       raven limit [[-t] TARGET [-m SIZE] [-c CPUS]]   show or change memory and CPU limits
       raven rename [-t] TARGET NAME                   rename a session
       raven run [-t TARGET] [--host] CMD...           start an app in a session
       raven run [-t TARGET] @LABEL                    start a host entry of menu.conf
       raven shell [-t TARGET]                         open a shell inside a session
       raven kill [-t] TARGET                          delete a session and its home
       raven pause [-t] TARGET                         freeze a session's apps, keeping them in memory
       raven resume [-t] TARGET                        continue a paused session
       raven recreate [-a | [-t] TARGET]               move sessions onto the current image
       raven backup [-t] TARGET [-o FILE] [--stop]     save a session's home and settings to a file
       raven restore FILE [-s NAME] [-w WM] [-g WxH] [-m SIZE] [-c CPUS] [CMD...]   make a new session from a backup
       raven build [DOCKER-BUILD-ARGS...]              build core + enabled addons
       raven addon ls | enable NAME | disable NAME | new NAME [PKG...]
       raven menu edit | show [-t TARGET] | sync
       raven home sync [-t TARGET]                     copy ~/.config/raven/home into running sessions
       raven hostd [status | start | stop]             host relay for "LABEL = @COMMAND" menu entries
       raven web COMMAND [OPTIONS]                    HTTPS/noVNC gateway (web --help for commands)
       raven wallpaper set [-t TARGET] [-m MODE] FILE | color [-t TARGET] '#rrggbb' | clear [-t TARGET] | show
       raven doctor                                    check what the server needs (read only)
       raven uninstall [-y] [-n] [--config] [--images] remove this user's sessions, homes and raven files

TARGET is a session id or name; the newest session when omitted.
new: CMD defaults to xterm, -d skips attaching, -w picks xmonad (default) or openbox.
wallpaper: without -t the setting applies to every session; -t sets one session's own.
home: files under ~/.config/raven/home go into every session home (symlinks followed).
attach: -d detaches other viewers of the session.
pause: viewers are disconnected and the apps stop where they are; the session keeps its
  memory until resume, and a server reboot loses that state. run --host apps keep running.
backup: a running session is frozen (docker pause) while its home is read and continues
  afterwards with its apps; the backup is like a power cut at that moment. A paused session
  is backed up as it is and stays paused. --stop instead stops the session (its apps end,
  unsaved work is lost) and starts it again afterwards. The file goes to
  ~/.local/share/raven/backups unless -o is given; ~/Downloads is not in it.
restore: always makes a new session; its name, window manager, size and command come from
  the backup unless given. Nothing is left behind when the backup is refused.
limits: -m SIZE (512m, 1.5g, 4g) and -c CPUS (0.5 up to the server's cores, two decimals) cap one
  session; N% is a share of the server (1-100, at least 512MiB and 0.5 CPU) and max is all of it.
  new and restore take RAVEN_MEMORY and RAVEN_CPUS, else 2g and 2. limit changes them at once,
  also while the session runs (its apps keep running); memory cannot go below what the session
  uses now + 64MiB, and a paused session can only be raised. limit without TARGET lists every
  session. recreate keeps the limits.
EOF
}

die() { echo "raven: $*" >&2; exit 1; }

cname() { echo "raven-$user-$1"; }
vname() { echo "raven-$user-home-$1"; }

# One line per session, newest first: ID DISPLAY PORT STATE CMD
sessions() {
    docker ps -a --filter "label=raven.user=$user" \
        --format '{{.Label "raven.id"}} {{.Label "raven.display"}} {{.Label "raven.port"}} {{.State}} {{.Label "raven.cmd"}}'
}

field() { sessions | awk -v id="$1" -v n="$2" '$1 == id { print $n }'; }
ids() { sessions | awk '{ print $1 }'; }
name_of() { cat "$statedir/$1.name" 2>/dev/null || true; }
label_of() { docker inspect -f "{{index .Config.Labels \"$2\"}}" "$1"; }

resolve() {
    local i
    case "$1" in
        "")
            i=$(ids | head -n 1)
            [ -n "$i" ] || die "no sessions"
            echo "$i" ;;
        *[!0-9]*)
            for i in $(ids); do
                [ "$(name_of "$i")" != "$1" ] || { echo "$i"; return 0; }
            done
            die "no session named '$1'" ;;
        *)
            [ -n "$(field "$1" 1)" ] || die "no session $1"
            echo "$1" ;;
    esac
}

check_name() {
    case "$1" in
        [A-Za-z]*) ;;
        *) die "name must start with a letter: '$1'" ;;
    esac
    case "$1" in
        *[!A-Za-z0-9_.-]*) die "name may only contain letters, digits, '_', '.', '-': '$1'" ;;
    esac
    local i
    for i in $(ids); do
        [ "$i" = "${2:-}" ] || [ "$(name_of "$i")" != "$1" ] || die "name '$1' is used by session $i"
    done
}

check_geometry() {
    case "$1" in
        *[!0-9x]* | x* | *x | *x*x*) die "geometry must look like 1600x900: '$1'" ;;
        *x*) ;;
        *) die "geometry must look like 1600x900: '$1'" ;;
    esac
}

need_display() {
    [ -n "${DISPLAY:-}" ] || die "DISPLAY is not set; connect with X11 forwarding (ssh -Y)"
}

need_image() {
    docker image inspect "$image" >/dev/null 2>&1 || die "image $image not found; run: raven build"
}

# Run a command inside session $1 against its own display
xin() {
    local id=$1
    shift
    docker exec -e DISPLAY=":$(field "$id" 2)" -e XAUTHORITY=/home/raven/.Xauthority \
        -w /home/raven "$(cname "$id")" "$@"
}

# Unpack a tar from stdin into session $1's home as the session user; directories that
# already exist keep their mode and times. A stopped session is reached through its volume.
untar_home() {
    local c
    c=$(cname "$1")
    if [ "$(docker inspect -f '{{.State.Running}}' "$c")" = true ]; then
        docker exec -i "$c" tar -C /home/raven --no-overwrite-dir -xf -
    else
        docker run --rm -i --network none -v "$(vname "$1"):/home/raven" --entrypoint tar \
            "$(docker inspect -f '{{.Image}}' "$c")" -C /home/raven --no-overwrite-dir -xf -
    fi
}

# $confdir/home mirrors the session home (/home/raven). Its files are copied into session $1,
# running or not, when they changed since the last copy; symlinks are followed on the host,
# so a link into a dotfiles repo copies what it points to. Returns 0 when copied, 1 when
# there was nothing new, 2 on failure.
push_home() {
    local id=$1 t sum rc=0
    [ -n "$(ls -A "$confdir/home" 2>/dev/null)" ] || return 1
    t=$(mktemp) || return 2
    if (cd "$confdir/home" && find . -mindepth 1 -maxdepth 1 -print0 \
            | tar --null -T - --sort=name -chf -) > "$t" 2>/dev/null; then
        sum=$(sha256sum < "$t")
        if [ "$sum" = "$(cat "$statedir/$id.home" 2>/dev/null)" ]; then
            rc=1
        elif untar_home "$id" < "$t" >/dev/null; then
            { mkdir -p "$statedir" && echo "$sum" > "$statedir/$id.home"; } || rc=2
        else
            rc=2
        fi
    else
        rc=2
    fi
    rm -f "$t"
    return "$rc"
}

# Let a running session's hooks pick up new home files; images before hooks have none
reload_session() {
    xin "$1" sh -c 'command -v raven-session-hooks >/dev/null || exit 0; exec raven-session-hooks reload'
}

# Copy the host menu rules into a running session
push_menu() {
    if [ -f "$confdir/menu.conf" ]; then
        docker exec -i "$(cname "$1")" sh -c 'mkdir -p ~/.config/raven && cat > ~/.config/raven/menu.conf' \
            < "$confdir/menu.conf"
    else
        docker exec "$(cname "$1")" rm -f /home/raven/.config/raven/menu.conf
    fi
}

# Wallpaper settings: wallpaper.{conf,img} in $confdir apply to every session and are
# copied into session homes; wallpaper.local.{conf,img} in a session home win there.
# The image label works for stopped sessions too and costs no docker exec.
has_wallpaper() {
    case " $(label_of "$(cname "$1")" raven.features 2>/dev/null) " in
        *" wallpaper "*) return 0 ;;
    esac
    return 1
}

apply_wallpaper() {
    docker exec -d -e DISPLAY=":$(field "$1" 2)" -e XAUTHORITY=/home/raven/.Xauthority \
        "$(cname "$1")" raven-wallpaper
}

# Write NAME.img (or remove it when IMG is empty) and then NAME.conf with text CONF into the
# session home, each through a temp file. The old conf goes first, so an interrupted copy
# leaves no conf and is redone on the next push instead of pairing a conf with a wrong image.
put_wallpaper() {
    local c="$1" n="$2" conf="$3" img="$4" d=/home/raven/.config/raven
    docker exec "$c" sh -c "mkdir -p $d && rm -f $d/$n.conf" || return 1
    if [ -n "$img" ]; then
        docker exec -i "$c" sh -c "cat > $d/$n.img.tmp && mv -f $d/$n.img.tmp $d/$n.img" < "$img" || return 1
    else
        docker exec "$c" rm -f "$d/$n.img" || return 1
    fi
    printf '%s\n' "$conf" | docker exec -i "$c" sh -c "cat > $d/$n.conf.tmp && mv -f $d/$n.conf.tmp $d/$n.conf" \
        || return 1
}

# Copy the host-wide wallpaper into session $1 when it changed.
# Returns 0 when up to date or applied, 1 on failure, 2 when the session's image has no support.
push_wallpaper() {
    local c cur
    c=$(cname "$1")
    has_wallpaper "$1" || return 2
    # A copy whose image does not match its sha (two writers at once) gets a marker line,
    # so it never equals the host's conf and is copied again or removed
    cur=$(docker exec "$c" sh -c 'd=/home/raven/.config/raven; cat $d/wallpaper.conf || exit 0
        s=$(sed -n "s/^sha=//p" $d/wallpaper.conf)
        [ -z "$s" ] || [ "$(sha256sum < $d/wallpaper.img)" = "$s  -" ] || echo "# image does not match"' 2>/dev/null) || cur=
    if [ -f "$confdir/wallpaper.conf" ]; then
        [ "$cur" != "$(cat "$confdir/wallpaper.conf")" ] || return 0
        if [ -f "$confdir/wallpaper.img" ]; then
            put_wallpaper "$c" wallpaper "$(cat "$confdir/wallpaper.conf")" "$confdir/wallpaper.img" || return 1
        else
            put_wallpaper "$c" wallpaper "$(cat "$confdir/wallpaper.conf")" "" || return 1
        fi
    else
        [ -n "$cur" ] || return 0
        docker exec "$c" rm -f /home/raven/.config/raven/wallpaper.conf /home/raven/.config/raven/wallpaper.img \
            || return 1
    fi
    # Without the conf the next push copies again and retries the paint
    apply_wallpaper "$1" || { docker exec "$c" rm -f /home/raven/.config/raven/wallpaper.conf; return 1; }
}

hostd_pid() {
    ss -Hxlp | grep -F "@raven-host-$(id -u) " | grep -o 'pid=[0-9]*' | head -n 1 | cut -d = -f 2
}

# Start the host relay (raven-hostd) unless it is already listening
ensure_hostd() {
    local i=0
    [ -z "$(hostd_pid)" ] || return 0
    mkdir -p "$rundir"
    chmod 700 "$rundir"
    setsid python3 "$srcdir/raven-hostd" "$self" >>"$rundir/hostd.log" 2>&1 </dev/null &
    until [ -n "$(hostd_pid)" ]; do
        i=$((i + 1))
        [ "$i" -le 20 ] || { echo "raven: host relay did not start; see $rundir/hostd.log" >&2; return 1; }
        sleep 0.1
    done
}

# A paused session can neither run docker exec nor be started; it is left as it is
refuse_paused() {
    [ "$(field "$1" 4)" != paused ] || die "session $1 is paused; resume it first: raven resume $1"
}

ensure_up() {
    local c port i=0 home=0 started=0
    refuse_paused "$1"
    c=$(cname "$1")
    # Before a start, so the session's start hooks already see the new files
    push_home "$1" || home=$?
    if [ "$(field "$1" 4)" != running ]; then
        docker start "$c" >/dev/null
        started=1
    fi
    port=$(field "$1" 3)
    until ss -Hltn "sport = :$port" | grep -q .; do
        i=$((i + 1))
        [ "$i" -le 40 ] || die "session $1 did not come up; check: docker logs $c"
        sleep 0.25
    done
    push_menu "$1"
    # The wallpaper is cosmetic; never let it stop attach, run or new
    push_wallpaper "$1" || [ $? -eq 2 ] || echo "raven: session $1: wallpaper not updated" >&2
    case "$home" in
        0) [ "$started" = 1 ] || reload_session "$1" || echo "raven: session $1: session hooks failed" >&2 ;;
        2) echo "raven: session $1: home files not updated" >&2 ;;
    esac
    ensure_hostd || true
}

# Lowest id with neither a container nor a leftover home volume
free_id() {
    local used i=0
    used=$(ids)
    while echo "$used" | grep -qx "$i" || docker volume inspect "$(vname "$i")" >/dev/null 2>&1; do
        i=$((i + 1))
    done
    echo "$i"
}

# Lowest display not claimed by any raven container, live X socket, or VNC port
free_display() {
    local taken d=$display_base
    taken=$( (docker ps -a --filter label=raven.display --format '{{.Label "raven.display"}}'
              ss -Hxl | grep -o 'X11-unix/X[0-9]*' | sed 's/.*X//') | sort -u)
    while echo "$taken" | grep -qx "$d" || ss -Hltn "sport = :$((port_base + d - display_base))" | grep -q .; do
        d=$((d + 1))
    done
    echo "$d"
}

# The server's time zone: $TZ, else the zone /etc/localtime points to, else /etc/timezone
host_tz() {
    local z=${TZ:-}
    [ -n "$z" ] || z=$(readlink -f /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p')
    [ -n "$z" ] || z=$(cat /etc/timezone 2>/dev/null || true)
    echo "${z:-UTC}"
}

# Memory and CPU limits. Refusals of a value exit with 3, of a memory limit below what a running
# session uses with 4, and of lowering a paused session with 5, so the web broker can tell them apart.
limit_refused() {
    local rc=$1
    shift
    echo "raven: $*" >&2
    exit "$rc"
}

# The server's memory in bytes (MemTotal)
server_memory() {
    awk '$1 == "MemTotal:" { printf "%.0f\n", $2 * 1024; exit }' "$proc_root/meminfo" 2>/dev/null
}

# The cores sessions can use; OMP_NUM_THREADS would change what nproc says
server_cpus() {
    env -u OMP_NUM_THREADS -u OMP_THREAD_LIMIT nproc
}

# Bytes of SIZE (512m, 1.5g, 4g, 25%, max) for a memory limit; $2 names it in refusals
memory_bytes() {
    local v=$1 what=${2:-memory} total b
    total=$(server_memory)
    [ -n "$total" ] || die "cannot read the server's memory from $proc_root/meminfo"
    case "$v" in
        max)
            echo $((total / 1048576 * 1048576))
            return 0 ;;
        *%)
            # A share of the server, in whole MiB
            printf '%s\n' "$v" | grep -Eqx '[0-9]+(\.[0-9]{1,2})?%' \
                || limit_refused 3 "$what must look like 512m, 1.5g, 4g, 25% or max: '$v'"
            b=$(awk -v t="$total" -v p="${v%\%}" 'BEGIN {
                if (p < 1 || p > 100) exit 1
                printf "%.0f\n", int(t * p / 100 / 1048576 + 1e-9) * 1048576 }') \
                || limit_refused 3 "$what must be a share from 1% to 100% of the server: '$v'"
            [ "$b" -ge "$memory_floor" ] || limit_refused 3 "$what $v of the server's $(limit_text "$total") is" \
                "$(limit_text "$b"), below the minimum 512MiB: '$v'"
            echo "$b"
            return 0 ;;
    esac
    printf '%s\n' "$v" | grep -Eqx '[0-9]+(\.[0-9]+)?[kKmMgG]' \
        || limit_refused 3 "$what must look like 512m, 1.5g, 4g, 25% or max: '$v'"
    b=$(printf '%s\n' "$v" | awk '{
        u = tolower(substr($0, length($0))); n = substr($0, 1, length($0) - 1) + 0
        b = int(n * (u == "k" ? 1024 : u == "m" ? 1048576 : 1073741824))
        printf "%.0f\n", (b > 1e18 ? 1e18 : b) }')
    [ "$b" -ge "$memory_floor" ] || limit_refused 3 "$what must be at least 512MiB: '$v'"
    [ "$b" -le "$total" ] || limit_refused 3 "$what can be at most the server's memory, $(limit_text "$total"): '$v'"
    echo "$b"
}

# Billionths of a CPU (Docker's NanoCpus) for CPUS (0.5, 2, 2.25, 25%, max); $2 names it in refusals
cpus_nano() {
    local v=$1 what=${2:-CPUs} n nano
    n=$(server_cpus)
    case "$v" in
        max)
            echo $((n * 1000000000))
            return 0 ;;
        *%)
            # A share of the server's cores, to two decimals
            printf '%s\n' "$v" | grep -Eqx '[0-9]+(\.[0-9]{1,2})?%' \
                || limit_refused 3 "$what must be a number of cores like 1, 1.5 or 2.25, a share like 25%, or max: '$v'"
            nano=$(awk -v n="$n" -v p="${v%\%}" 'BEGIN {
                if (p < 1 || p > 100) exit 1
                printf "%.0f\n", sprintf("%.2f", n * p / 100) * 1e9 }') \
                || limit_refused 3 "$what must be a share from 1% to 100% of the server: '$v'"
            [ "$nano" -ge 500000000 ] || limit_refused 3 "$what $v of the server's $n cores is" \
                "$(cpus_text "$nano"), below the minimum 0.5: '$v'"
            echo "$nano"
            return 0 ;;
    esac
    printf '%s\n' "$v" | grep -Eqx '[0-9]+(\.[0-9]{1,2})?' \
        || limit_refused 3 "$what must be a number of cores like 1, 1.5 or 2.25, a share like 25%, or max: '$v'"
    nano=$(awk -v c="$v" 'BEGIN { x = c * 1e9; printf "%.0f\n", (x > 1e18 ? 1e18 : x) }')
    [ "$nano" -ge 500000000 ] || limit_refused 3 "$what must be at least 0.5: '$v'"
    [ "$nano" -le $((n * 1000000000)) ] || limit_refused 3 "$what can be at most the server's $n cores: '$v'"
    echo "$nano"
}

# A limit in bytes as 512MiB, 2GiB or 1.5GiB (one decimal; whole GiB without one)
limit_text() {
    awk -v b="$1" 'BEGIN {
        if (b < 1073741824) printf "%dMiB\n", b / 1048576
        else if (b % 1073741824 == 0) printf "%dGiB\n", b / 1073741824
        else printf "%.1fGiB\n", b / 1073741824 }'
}

# NanoCpus as cores: 2, 2.5, 0.75
cpus_text() {
    awk -v n="$1" 'BEGIN { s = sprintf("%.2f", n / 1e9); sub(/0+$/, "", s); sub(/\.$/, "", s); print s }'
}

# NanoCpus as an exact --cpus value
cpus_arg() {
    awk -v n="$1" 'BEGIN { s = sprintf("%.9f", n / 1e9); sub(/0+$/, "", s); sub(/\.$/, "", s); print s }'
}

# $1 as a share of $2: "25%", "12.5%" (at most one decimal)
share_text() {
    awk -v a="$1" -v b="$2" 'BEGIN { s = sprintf("%.1f", a * 100 / b); sub(/\.0$/, "", s); print s "%" }'
}

# True for a whole number above 0; Docker shows no limit as 0, -1 or <nil>
positive() {
    case "$1" in
        '' | *[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 0 ]
}

# A memory limit with its share of the server: "8GiB (25% of 31.3GiB)", "31.3GiB (max)" when it is the
# whole server (whole MiB), "none"; with $2 = brief only "8GiB" and "31.3GiB (max)"
memory_limit_text() {
    local total
    positive "$1" || { echo none; return 0; }
    total=$(server_memory)
    if [ -z "$total" ]; then
        limit_text "$1"
    elif [ "$1" -ge $((total / 1048576 * 1048576)) ]; then
        echo "$(limit_text "$1") (max)"
    elif [ -n "${2:-}" ]; then
        limit_text "$1"
    else
        echo "$(limit_text "$1") ($(share_text "$1" "$total") of $(limit_text "$total"))"
    fi
}

# A CPU limit with its share of the server: "4 (25% of 16)", "16 (max)" when it is every core, "none";
# with $2 = brief only "4" and "16 (max)"
cpus_limit_text() {
    local n
    positive "$1" || { echo none; return 0; }
    n=$(server_cpus)
    if [ "$1" -ge $((n * 1000000000)) ]; then
        echo "$(cpus_text "$1") (max)"
    elif [ -n "${2:-}" ]; then
        cpus_text "$1"
    else
        echo "$(cpus_text "$1") ($(share_text "$1" $((n * 1000000000))) of $n)"
    fi
}

# NanoCpus as "2.5 cores (15.6% of 16)", "1 core (6.2% of 16)", "16 cores (max)" or "none"
cores_text() {
    local c
    positive "$1" || { echo none; return 0; }
    c=$(cpus_text "$1")
    printf '%s core%s%s\n' "$c" "$([ "$c" = 1 ] || echo s)" "$(cpus_limit_text "$1" | sed 's/^[^ ]*//')"
}

# "memory limit 2GiB (6.4% of 31.3GiB), 2 cores (12.5% of 16)" for BYTES NANOCPUS
limits_summary() {
    printf 'memory limit %s, %s\n' "$(memory_limit_text "$1")" "$(cores_text "$2")"
}

# Limits of a new session: "BYTES NANOCPUS" from the -m and -c values when given ($1, $3 are 1),
# else from RAVEN_MEMORY and RAVEN_CPUS, else the defaults; exits 3 on a bad value
new_limits() {
    local mem nano
    if [ "$1" = 1 ]; then
        mem=$(memory_bytes "$2" memory) || exit $?
    elif [ -n "${RAVEN_MEMORY:-}" ]; then
        mem=$(memory_bytes "$RAVEN_MEMORY" RAVEN_MEMORY) || exit $?
    else
        mem=$(memory_bytes "$default_memory") || exit $?
    fi
    if [ "$3" = 1 ]; then
        nano=$(cpus_nano "$4" CPUs) || exit $?
    elif [ -n "${RAVEN_CPUS:-}" ]; then
        nano=$(cpus_nano "$RAVEN_CPUS" RAVEN_CPUS) || exit $?
    else
        nano=$(cpus_nano "$default_cpus") || exit $?
    fi
    echo "$mem $nano"
}

# Create the container for session $1; runtime needs come from the image's addon labels.
# Limits: $7 memory bytes, $8 NanoCpus, $9 pids.
run_container() {
    local id=$1 d=$2 p=$3 cmd=$4 geometry=$5 wm=$6 mem=$7 nano=$8 pids=$9 seccomp shm uid
    seccomp=$(docker image inspect -f '{{index .Config.Labels "raven.seccomp"}}' "$image")
    shm=$(docker image inspect -f '{{index .Config.Labels "raven.shm-size"}}' "$image")
    uid=$(docker image inspect -f '{{index .Config.Labels "raven.uid"}}' "$image")
    set -- --name "$(cname "$id")" --restart unless-stopped --init --network host
    # The same memory as memory+swap: sessions get no swap
    set -- "$@" --memory "$mem" --memory-swap "$mem" --cpus "$(cpus_arg "$nano")" --pids-limit "$pids"
    [ -z "$seccomp" ] || set -- "$@" --security-opt "seccomp=$seccomp"
    [ -z "$shm" ] || set -- "$@" --shm-size "$shm"
    # The session user is not the host user. The host user's group lets it share ~/Downloads,
    # and the setgid bit keeps the files it makes there in that group.
    mkdir -p "$HOME/Downloads"
    chmod g+rwxs "$HOME/Downloads"
    docker create "$@" \
        --label raven.user="$user" --label raven.id="$id" \
        --label raven.display="$d" --label raven.port="$p" \
        --label raven.cmd="$cmd" --label raven.geometry="$geometry" --label raven.wm="$wm" \
        -e RAVEN_DISPLAY="$d" -e RAVEN_PORT="$p" -e RAVEN_GEOMETRY="$geometry" -e RAVEN_WM="$wm" \
        -e RAVEN_ID="$id" -e RAVEN_TITLE="raven $id" -e RAVEN_CMD="$cmd" -e RAVEN_HOST_UID="$(id -u)" \
        -e TZ="$(host_tz)" \
        --group-add "$(id -g)" \
        -v "$(vname "$id"):/home/raven" \
        -v "$HOME/Downloads:/home/raven/Downloads" \
        "$image" >/dev/null
    # A home made under another session uid (older images used the host user's uid) is handed
    # over to this image's session user before the start
    [ -z "$uid" ] || docker run --rm --network none --user 0 -v "$(vname "$id"):/home/raven" \
        --entrypoint find "$image" /home/raven -xdev \( ! -user "$uid" -o ! -group "$uid" \) \
        -exec chown -h "$uid:$uid" {} + \
        || echo "raven: session $id: could not hand the home over to uid $uid" >&2
    # Home files go in before the first start, so session hooks see them from the beginning
    push_home "$id" || [ $? -eq 1 ] || echo "raven: session $id: home files not copied" >&2
    docker start "$(cname "$id")" >/dev/null
}

view() {
    local id=$1 geometry=$2 exclusive=$3 c port xa=/tmp/viewer.xauth xi
    c=$(cname "$id")
    port=$(field "$id" 3)
    if [ -n "$geometry" ]; then
        # Set a mode on the output; "xrandr --fb" smaller than the output fails and turns the output off
        xin "$id" sh -c '
            m=$1 w=${1%x*} h=${1#*x}
            out=$(xrandr --query | awk "/ (dis)?connected/ { print \$1; exit }")
            xrandr --newmode "$m" 60 "$w" "$w" "$w" "$w" "$h" "$h" "$h" "$h" 2>/dev/null
            xrandr --addmode "$out" "$m" 2>/dev/null
            xrandr --output "$out" --mode "$m"' sh "$geometry" >/dev/null 2>&1 \
            || die "cannot resize session $id to $geometry"
    fi
    docker exec "$c" sh -c ": > $xa"
    xauth nlist "$DISPLAY" 2>/dev/null | docker exec -i "$c" xauth -q -f "$xa" nmerge - 2>/dev/null || true
    xi=$(docker exec -e DISPLAY="$DISPLAY" -e XAUTHORITY="$xa" "$c" xinput --version 2>/dev/null \
        | sed -n 's/^XI version on server: \([0-9][0-9]*\).*/\1/p')
    if [ "${xi:-0}" -ge 2 ]; then
        set -- xtigervncviewer "-Shared=$((1 - exclusive))"
    else
        # xtigervncviewer refuses to run without XInput 2 (e.g. Xming 6.9)
        set -- xtightvncviewer -encodings "copyrect raw"
        [ "$exclusive" = 0 ] || set -- "$@" -noshared
    fi
    exec docker exec -e DISPLAY="$DISPLAY" -e XAUTHORITY="$xa" "$c" \
        "$@" -passwd /home/raven/.vnc/passwd "localhost::$port"
}

check_wm() {
    case "$1" in
        xmonad | openbox) ;;
        *) die "window manager must be xmonad or openbox: '$1'" ;;
    esac
}

cmd_new() {
    local detach=0 name= geometry=$default_geometry wm=$default_wm opt cmd id d p
    local mem_set=0 mem= cpus_set=0 cpus= limits
    OPTIND=1
    while getopts ds:g:w:m:c: opt; do
        case "$opt" in
            d) detach=1 ;;
            s) name=$OPTARG ;;
            g) geometry=$OPTARG ;;
            w) wm=$OPTARG ;;
            m) mem_set=1 mem=$OPTARG ;;
            c) cpus_set=1 cpus=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    cmd=${*:-$default_cmd}
    check_wm "$wm"
    check_geometry "$geometry"
    [ -z "$name" ] || check_name "$name"
    limits=$(new_limits "$mem_set" "$mem" "$cpus_set" "$cpus") || exit $?
    [ "$detach" = 1 ] || need_display
    need_image

    id=$(free_id)
    d=$(free_display)
    p=$((port_base + d - display_base))
    mkdir -p "$HOME/Downloads" "$statedir"
    rm -f "$statedir/$id.name" "$statedir/$id.home"
    [ -z "$name" ] || echo "$name" > "$statedir/$id.name"
    # shellcheck disable=SC2086
    run_container "$id" "$d" "$p" "$cmd" "$geometry" "$wm" $limits "$session_pids"
    ensure_up "$id"
    # shellcheck disable=SC2086
    echo "raven: created session $id${name:+ ($name)} with $wm; $(limits_summary $limits)" >&2
    [ "$detach" = 1 ] || view "$id" "" 0
}

cmd_attach() {
    local exclusive=0 geometry= target= opt id
    OPTIND=1
    while getopts dg:t: opt; do
        case "$opt" in
            d) exclusive=1 ;;
            g) geometry=$OPTARG ;;
            t) target=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -le 1 ] || die "usage: raven attach [-d] [-g WxH] [TARGET]"
    target=${target:-${1:-}}
    [ -z "$geometry" ] || check_geometry "$geometry"
    need_display
    id=$(resolve "$target")
    ensure_up "$id"
    view "$id" "$geometry" "$exclusive"
}

# cgroup (v2) directory of the container whose init process is $1
cgroup_of() {
    local g
    [ "${1:-0}" -gt 0 ] || return 1
    g=$(sed -n 's/^0:://p' "$proc_root/$1/cgroup" 2>/dev/null) || return 1
    [ -n "$g" ] && [ -d "$cgroup_root$g" ] || return 1
    echo "$cgroup_root$g"
}

# "FILE USEC" for the CPU time used so far, from each cpu.stat file given
cpu_usage() {
    [ $# -eq 0 ] || awk '$1 == "usage_usec" { print FILENAME, $2 }' "$@" 2>/dev/null || true
}

# Bytes as MiB, or as GiB from 1 GiB up
size_text() {
    awk -v b="$1" 'BEGIN { if (b < 1073741824) printf "%dMiB\n", b / 1048576; else printf "%.1fGiB\n", b / 1073741824 }'
}

# X11 viewers (raven attach) are VNC viewer processes inside the session, in its cgroup $1
x11_viewers() {
    local procs
    procs=$(cat "$1/cgroup.procs" 2>/dev/null) || return 1
    echo "$procs" | sed "s|.*|$proc_root/&/comm|" | xargs -r cat 2>/dev/null | grep -cxE 'xt(iger|ight)vncviewer' || true
}

# Established connections to the VNC port $1: X11 viewers and the web broker's
vnc_clients() {
    ss -Htn state established "( sport = :$1 )" | grep -c . || true
}

# Limits and processes of the sessions given on stdin (one id per line), with one docker inspect:
# ID PID MEMORY NANOCPUS PIDS WM (PID 0 when stopped; no limit is 0, -1 or <nil>; WM may be empty)
resources() {
    while read -r id; do cname "$id"; done \
        | xargs -r docker inspect -f '{{index .Config.Labels "raven.id"}} {{.State.Pid}} {{.HostConfig.Memory}} {{.HostConfig.NanoCpus}} {{.HostConfig.PidsLimit}} {{index .Config.Labels "raven.wm"}}' \
        2>/dev/null || true
}

# "ID CGROUP" for each line of resources() whose session has a readable cgroup
cgroups_of() {
    echo "$1" | while read -r id pid rest; do
        g=$(cgroup_of "$pid") && echo "$id $g"
    done || true
}

# One CPU sample for the cgroups in $1 ("ID CGROUP" lines): the time each used in a quarter
# second. Sets cpu_s1, cpu_s2 ("FILE USEC" lines), cpu_t1, cpu_t2 (ns).
cpu_s1= cpu_s2= cpu_t1=0 cpu_t2=0
sample_cpu() {
    local files
    files=$(echo "$1" | awk 'NF == 2 { print $2 "/cpu.stat" }')
    [ -n "$files" ] || return 0
    cpu_t1=$(date +%s%N)
    # shellcheck disable=SC2086
    cpu_s1=$(cpu_usage $files)
    sleep 0.25
    cpu_t2=$(date +%s%N)
    # shellcheck disable=SC2086
    cpu_s2=$(cpu_usage $files)
}

# CPU use of cgroup $1 in the sample, one core = 100% ("12%"), or nothing when unknown
cpu_percent() {
    local a b e
    [ -n "$1" ] || return 0
    a=$(echo "$cpu_s1" | awk -v f="$1/cpu.stat" '$1 == f { print $2 }')
    b=$(echo "$cpu_s2" | awk -v f="$1/cpu.stat" '$1 == f { print $2 }')
    e=$(((cpu_t2 - cpu_t1) / 1000))
    if [ -n "$a" ] && [ -n "$b" ] && [ "$e" -gt 0 ]; then
        echo "$((((b - a) * 100 + e / 2) / e))%"
    fi
}

# Memory use of cgroup $1 in bytes, or nothing
memory_current() {
    [ -n "$1" ] || return 0
    cat "$1/memory.current" 2>/dev/null || true
}

# "used/limit" cell parts: a limit as 2GiB or none; cores as 2.5 or none
short_memory_limit() { if positive "$1"; then limit_text "$1"; else echo none; fi; }
short_cpus_limit() { if positive "$1"; then cpus_text "$1"; else echo none; fi; }

cmd_ls() {
    local out info groups conns id display port state cmd name wm pid g x11 web cpu mem b lmem lcpu
    out=$(sessions | sort -n)
    [ -n "$out" ] || { echo "no sessions"; return 0; }
    info=$(echo "$out" | awk '{ print $1 }' | resources)
    groups=$(cgroups_of "$info")
    # One CPU sample for all running sessions (one core is 100%)
    sample_cpu "$(echo "$groups" | awk -v r="$(echo "$out" | awk '$4 == "running" { printf " %s ", $1 }')" \
        'index(r, " " $1 " ")')"
    conns=$(ss -Htn state established 2>/dev/null | awk '{ n = split($3, a, ":"); print a[n] }') || true
    printf '%-4s %-16s %-8s %-8s %-8s %-6s %-4s %-4s %-8s %-14s %s\n' \
        ID NAME STATE WM DISPLAY PORT X11 WEB CPU MEM CMD
    echo "$out" | while read -r id display port state cmd; do
        name=$(name_of "$id")
        # Sessions made before window managers were selectable run openbox
        wm=$(echo "$info" | awk -v id="$id" '$1 == id { print $6 }')
        lmem=$(short_memory_limit "$(echo "$info" | awk -v id="$id" '$1 == id { print $3 }')")
        lcpu=$(short_cpus_limit "$(echo "$info" | awk -v id="$id" '$1 == id { print $4 }')")
        g=$(echo "$groups" | awk -v id="$id" '$1 == id { print $2 }')
        x11=- web=- cpu=- mem=-
        case "$state" in
            running | paused)
                mem='?'
                b=$(memory_current "$g")
                [ -z "$b" ] || mem=$(size_text "$b") ;;
        esac
        case "$state" in
            running)
                cpu=$(cpu_percent "$g")
                cpu=${cpu:-?}
                x11='?' web='?'
                if [ -n "$g" ] && x11=$(x11_viewers "$g"); then
                    # The other connections to the VNC port are web viewers
                    web=$(($(echo "$conns" | grep -cx "$port" || true) - x11))
                    [ "$web" -ge 0 ] || web=0
                else
                    x11='?'
                fi ;;
            # Frozen, and pause disconnected every viewer
            paused) cpu=0% ;;
        esac
        printf '%-4s %-16s %-8s %-8s %-8s %-6s %-4s %-4s %-8s %-14s %s\n' \
            "$id" "${name:--}" "$state" "${wm:-openbox}" ":$display" "$port" "$x11" "$web" "$cpu/$lcpu" \
            "$mem/$lmem" "$cmd"
    done
    if echo "$out" | awk '$4 == "paused" { found = 1 } END { exit !found }'; then
        echo "paused sessions keep their memory until resumed; a server reboot loses them"
    fi
}

# Show session $1's limits and use
limit_show() {
    local id=$1 name state info groups g mem cpu pids
    name=$(name_of "$id")
    state=$(field "$id" 4)
    info=$(echo "$id" | resources)
    groups=$(cgroups_of "$info")
    g=$(echo "$groups" | awk -v id="$id" '$1 == id { print $2 }')
    mem=- cpu=-
    case "$state" in
        running)
            sample_cpu "$groups"
            cpu=$(cpu_percent "$g")
            cpu="${cpu:-?} (one core = 100%)" ;;
        paused) cpu="0% (paused)" ;;
    esac
    case "$state" in
        running | paused)
            mem=$(memory_current "$g")
            if [ -n "$mem" ]; then mem=$(size_text "$mem"); else mem='?'; fi ;;
    esac
    # shellcheck disable=SC2086
    set -- $info
    pids=none
    ! positive "${5:-}" || pids=$5
    echo "session $id${name:+ ($name)}: $state"
    echo "memory  used $mem, limit $(memory_limit_text "${3:-}")"
    echo "cpu     used $cpu, limit $(cores_text "${4:-}")"
    echo "pids    limit $pids"
}

# Every session's limits and use, and whether the memory limits add up to more than the server has
limit_table() {
    local out info groups total sum=0 open=0 id display port state cmd name g mem cpu lmem lcpu pids rows
    out=$(sessions | sort -n)
    [ -n "$out" ] || { echo "no sessions"; return 0; }
    total=$(server_memory)
    [ -n "$total" ] || die "cannot read the server's memory from $proc_root/meminfo"
    info=$(echo "$out" | awk '{ print $1 }' | resources)
    groups=$(cgroups_of "$info")
    sample_cpu "$(echo "$groups" | awk -v r="$(echo "$out" | awk '$4 == "running" { printf " %s ", $1 }')" \
        'index(r, " " $1 " ")')"
    printf '%-4s %-16s %-8s %-8s %-26s %-6s %-19s %s\n' ID NAME STATE MEM MEM-LIMIT CPU CPU-LIMIT PIDS
    rows=$(echo "$out" | awk '{ print $1, $4 }')
    for id in $(echo "$rows" | awk '{ print $1 }'); do
        state=$(echo "$rows" | awk -v id="$id" '$1 == id { print $2 }')
        name=$(name_of "$id")
        # shellcheck disable=SC2046
        set -- $(echo "$info" | awk -v id="$id" '$1 == id { print $3, $4, $5 }')
        lmem=$(memory_limit_text "${1:-}")
        lcpu=$(cpus_limit_text "${2:-}")
        pids=none
        ! positive "${3:-}" || pids=$3
        # A session without a limit can take the whole server
        if positive "${1:-}"; then sum=$((sum + $1)); else sum=$((sum + total)); open=$((open + 1)); fi
        g=$(echo "$groups" | awk -v id="$id" '$1 == id { print $2 }')
        mem=- cpu=-
        case "$state" in
            running | paused)
                mem=$(memory_current "$g")
                if [ -n "$mem" ]; then mem=$(size_text "$mem"); else mem='?'; fi ;;
        esac
        case "$state" in
            running) cpu=$(cpu_percent "$g"); cpu=${cpu:-?} ;;
            paused) cpu=0% ;;
        esac
        printf '%-4s %-16s %-8s %-8s %-26s %-6s %-19s %s\n' \
            "$id" "${name:--}" "$state" "$mem" "$lmem" "$cpu" "$lcpu" "$pids"
    done
    printf 'memory limits add up to %s%s; the server has %s\n' "$(limit_text "$sum")" \
        "$([ "$open" -eq 0 ] || echo " (a session without a limit counts as the whole server)")" \
        "$(limit_text "$total")"
    if [ "$sum" -gt "$total" ]; then
        echo "warning: sessions may use more memory together than the server has; if they do, the kernel kills apps"
    fi
}

# Change session $1's limits: $2 memory bytes and $3 NanoCpus, either empty to keep it
limit_change() {
    local id=$1 mem=$2 nano=$3 c name state old_mem old_nano pid g use need lower=0 now
    c=$(cname "$id")
    name=$(name_of "$id")
    state=$(field "$id" 4)
    # shellcheck disable=SC2046
    set -- $(docker inspect -f '{{.HostConfig.Memory}} {{.HostConfig.NanoCpus}} {{.State.Pid}}' "$c")
    old_mem=${1:-} old_nano=${2:-} pid=${3:-0}
    # No limit (0) is more than any limit
    if [ -n "$mem" ] && { ! positive "$old_mem" || [ "$mem" -lt "$old_mem" ]; }; then lower=1; fi
    if [ -n "$nano" ] && { ! positive "$old_nano" || [ "$nano" -lt "$old_nano" ]; }; then lower=$((lower + 2)); fi
    # Frozen processes cannot give memory back; the session can only grow until resumed
    [ "$state" != paused ] || [ "$lower" -eq 0 ] \
        || limit_refused 5 "session $id is paused; its limits can only be raised until it is resumed: raven resume $id"
    # cgroup v2 takes a memory limit below the use and then kills apps until they fit
    if [ $((lower % 2)) -eq 1 ]; then
        g=$(cgroup_of "$pid") || g=
        use=$(memory_current "$g")
        if [ -n "$use" ]; then
            need=$((use + memory_headroom))
            [ "$mem" -ge "$need" ] || limit_refused 4 "session $id uses $(size_text "$use") of memory now;" \
                "a limit below $(((need + 1048575) / 1048576))MiB (its use + 64MiB) would make the kernel kill its apps"
        elif [ "$state" = running ]; then
            die "cannot read the memory use of session $id; its limits were not changed"
        fi
    fi
    set --
    [ -z "$mem" ] || set -- --memory "$mem" --memory-swap "$mem"
    [ -z "$nano" ] || set -- "$@" --cpus "$(cpus_arg "$nano")"
    docker update "$@" "$c" >/dev/null || die "session $id: docker update failed; its limits were not changed"
    # Docker keeps the limits with the container, so they also hold after a restart or reboot
    now=$(docker inspect -f '{{.HostConfig.Memory}} {{.HostConfig.MemorySwap}} {{.HostConfig.NanoCpus}}' "$c")
    # shellcheck disable=SC2086
    set -- $now
    { [ -z "$mem" ] || { [ "${1:-}" = "$mem" ] && [ "${2:-}" = "$mem" ]; }; } \
        && { [ -z "$nano" ] || [ "${3:-}" = "$nano" ]; } \
        || die "session $id: the limits did not change as asked (now memory ${1:-?}, swap ${2:-?}, NanoCpus ${3:-?})"
    {
        printf 'raven: session %s%s:' "$id" "${name:+ ($name)}"
        [ -z "$mem" ] || printf ' memory limit %s -> %s' "$(memory_limit_text "$old_mem" brief)" \
            "$(memory_limit_text "$mem" brief)"
        [ -z "$mem" ] || [ -z "$nano" ] || printf ','
        [ -z "$nano" ] || printf ' cpus %s -> %s' "$(cpus_limit_text "$old_nano" brief)" \
            "$(cpus_limit_text "$nano" brief)"
        case "$state" in
            running | paused) echo "; applied now, its apps keep running" ;;
            *) echo "; it gets them when it starts" ;;
        esac
    } >&2
}

cmd_limit() {
    local target= mem= nano= mem_set=0 cpus_set=0 m= cpus= id
    local usage='usage: raven limit [[-t] TARGET [-m SIZE] [-c CPUS]]'
    while [ $# -gt 0 ]; do
        case "$1" in
            -t | -m | -c)
                [ $# -ge 2 ] || die "$1 needs an argument"
                case "$1" in
                    -t) target=$2 ;;
                    -m) mem_set=1 m=$2 ;;
                    *) cpus_set=1 cpus=$2 ;;
                esac
                shift 2 ;;
            -*) die "$usage" ;;
            *) [ -z "$target" ] || die "$usage"; target=$1; shift ;;
        esac
    done
    if [ -z "$target" ]; then
        [ "$mem_set$cpus_set" = 00 ] || die "name the session to change: raven limit [-t] TARGET [-m SIZE] [-c CPUS]"
        limit_table
        return
    fi
    # The values are checked before any session is looked up or changed
    [ "$mem_set" = 0 ] || { mem=$(memory_bytes "$m" memory) || exit $?; }
    [ "$cpus_set" = 0 ] || { nano=$(cpus_nano "$cpus" CPUs) || exit $?; }
    id=$(resolve "$target")
    [ "$mem_set$cpus_set" = 00 ] || limit_change "$id" "$mem" "$nano"
    limit_show "$id"
}

cmd_rename() {
    local target= opt id
    OPTIND=1
    while getopts t: opt; do
        case "$opt" in
            t) target=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    if [ -z "$target" ] && [ $# -eq 2 ]; then
        target=$1
        shift
    fi
    [ -n "$target" ] && [ $# -eq 1 ] || die "usage: raven rename [-t] TARGET NAME"
    id=$(resolve "$target")
    check_name "$1" "$id"
    mkdir -p "$statedir"
    echo "$1" > "$statedir/$id.name"
}

# Print the host command of LABEL: the last "LABEL = @COMMAND" rule in the host's
# menu.conf. Only this file can define host entries; sessions send just a label.
host_cmd() {
    [ -f "$confdir/menu.conf" ] || return 1
    awk -v want="$1" '
        /^[[:space:]]*(#|!|---|$)/ { next }
        {
            i = index($0, "=")
            if (!i) next
            k = substr($0, 1, i - 1); v = substr($0, i + 1)
            gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
            if (k == want) last = v
        }
        END {
            if (last !~ /^@/) exit 1
            last = substr(last, 2); sub(/^[ \t]+/, "", last)
            if (last == "") exit 1
            print last
        }' "$confdir/menu.conf"
}

cmd_run() {
    local target= host=0 id d xf cmd
    while [ $# -gt 0 ]; do
        case "$1" in
            -t) [ $# -ge 2 ] || die "-t needs a target"; target=$2; shift 2 ;;
            -H | --host) host=1; shift ;;
            --) shift; break ;;
            -*) die "unknown option: $1" ;;
            *) break ;;
        esac
    done
    [ $# -gt 0 ] || die "usage: raven run [-t TARGET] [--host] CMD... | @LABEL"
    case "$1" in
        @*)
            [ $# -eq 1 ] || die "usage: raven run [-t TARGET] @LABEL"
            cmd=$(host_cmd "${1#@}") \
                || die "no host entry '${1#@} = @COMMAND' in $confdir/menu.conf"
            set -- "$cmd"
            host=1 ;;
    esac
    id=$(resolve "$target")
    ensure_up "$id"
    if [ "$host" = 0 ]; then
        # docker exec does not inherit the entrypoint's umask (shared ~/Downloads)
        docker exec -d -e DISPLAY=":$(field "$id" 2)" -e XAUTHORITY=/home/raven/.Xauthority \
            -w /home/raven "$(cname "$id")" sh -c "umask 002; $*"
        return 0
    fi

    # Host apps reach the session's X socket through the shared network namespace
    d=$(field "$id" 2)
    mkdir -p "$rundir"
    chmod 700 "$rundir"
    xf=$rundir/$id.xauth
    (umask 077 && : > "$xf")
    docker exec "$(cname "$id")" xauth nlist ":$d" | xauth -q -f "$xf" nmerge -
    DISPLAY=":$d" XAUTHORITY="$xf" setsid sh -c "$*" >>"$rundir/$id.log" 2>&1 </dev/null &
}

cmd_shell() {
    local target= opt id
    OPTIND=1
    while getopts t: opt; do
        case "$opt" in
            t) target=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    target=${target:-${1:-}}
    id=$(resolve "$target")
    ensure_up "$id"
    exec docker exec -it -e DISPLAY=":$(field "$id" 2)" -e XAUTHORITY=/home/raven/.Xauthority \
        -w /home/raven "$(cname "$id")" sh -c 'umask 002; exec bash'
}

cmd_kill() {
    local target= opt id
    OPTIND=1
    while getopts t: opt; do
        case "$opt" in
            t) target=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    target=${target:-${1:-}}
    [ -n "$target" ] || die "usage: raven kill [-t] TARGET"
    id=$(resolve "$target")
    docker rm -f "$(cname "$id")" >/dev/null
    docker volume rm "$(vname "$id")" >/dev/null
    rm -f "$statedir/$id.name" "$statedir/$id.home" "$rundir/$id.xauth" "$rundir/$id.log"
}

# Disconnect every viewer of running session $1, as they would freeze with it: X11 viewers
# (raven attach) run inside the session; vncconfig drops the other VNC connections (web).
drop_viewers() {
    xin "$1" sh -c '
        pkill -x "xt(iger|ight)vncviewer"
        i=0
        while pgrep -x "xt(iger|ight)vncviewer" >/dev/null && [ "$i" -lt 20 ]; do
            sleep 0.1
            i=$((i + 1))
        done
        pkill -KILL -x "xt(iger|ight)vncviewer"
        vncconfig -display "$DISPLAY" -disconnect'
}

# Freeze the session's processes in memory (cgroup freezer) without ending them
cmd_pause() {
    local target= opt id c port name mem i=0
    OPTIND=1
    while getopts t: opt; do
        case "$opt" in
            t) target=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    target=${target:-${1:-}}
    [ -n "$target" ] || die "usage: raven pause [-t] TARGET"
    id=$(resolve "$target")
    case "$(field "$id" 4)" in
        running) ;;
        paused) die "session $id is already paused" ;;
        *) die "session $id is not running" ;;
    esac
    c=$(cname "$id")
    port=$(field "$id" 3)
    while :; do
        drop_viewers "$id" || die "session $id: cannot disconnect its viewers; not paused"
        docker pause "$c" >/dev/null
        # A viewer that connected in between would stay frozen: disconnect it and pause again
        [ "$(vnc_clients "$port")" -gt 0 ] || break
        i=$((i + 1))
        if [ "$i" -ge 3 ]; then
            echo "raven: session $id: a viewer connected during the pause; it stays frozen until resume" >&2
            break
        fi
        docker unpause "$c" >/dev/null
    done
    name=$(name_of "$id")
    mem=$(cgroup_of "$(docker inspect -f '{{.State.Pid}}' "$c")") && mem=$(cat "$mem/memory.current" 2>/dev/null) \
        && mem=$(size_text "$mem") || mem=
    echo "raven: paused session $id${name:+ ($name)}; its apps stop where they are, viewers were disconnected" >&2
    echo "raven: it keeps holding its memory${mem:+ ($mem)} until resumed; a server reboot loses the paused state" >&2
    echo "raven: apps started with run --host are not paused" >&2
    echo "raven: resume with: raven resume $id" >&2
}

cmd_resume() {
    local target= opt id name
    OPTIND=1
    while getopts t: opt; do
        case "$opt" in
            t) target=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    target=${target:-${1:-}}
    [ -n "$target" ] || die "usage: raven resume [-t] TARGET"
    id=$(resolve "$target")
    [ "$(field "$id" 4)" = paused ] || die "session $id is not paused"
    docker unpause "$(cname "$id")" >/dev/null
    name=$(name_of "$id")
    echo "raven: resumed session $id${name:+ ($name)}; its viewers were disconnected, attach again: raven attach $id" >&2
}

cmd_recreate() {
    local all=0 target= opt id targets c cmd geometry wm defaults mem nano pids display port
    OPTIND=1
    while getopts at: opt; do
        case "$opt" in
            a) all=1 ;;
            t) target=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    target=${target:-${1:-}}
    if [ "$all" = 1 ]; then
        targets=$(ids | sort -n)
    else
        [ -n "$target" ] || die "usage: raven recreate [-a | [-t] TARGET]"
        targets=$(resolve "$target")
    fi
    need_image
    # For sessions from before limits; checked before any session is stopped
    defaults=$(new_limits 0 "" 0 "") || exit $?
    for id in $targets; do
        # Recreating ends the apps a pause keeps; only an explicit target does that
        if [ "$all" = 1 ] && [ "$(field "$id" 4)" = paused ]; then
            echo "raven: session $id is paused; skipped (resume it, or recreate -t $id)" >&2
            continue
        fi
        c=$(cname "$id")
        cmd=$(label_of "$c" raven.cmd)
        geometry=$(label_of "$c" raven.geometry)
        wm=$(label_of "$c" raven.wm)
        display=$(field "$id" 2)
        port=$(field "$id" 3)
        # The new container keeps the limits, also ones changed with raven limit
        # shellcheck disable=SC2046
        set -- $(docker inspect -f '{{.HostConfig.Memory}} {{.HostConfig.NanoCpus}} {{.HostConfig.PidsLimit}}' "$c")
        mem=${defaults% *} nano=${defaults#* } pids=$session_pids
        ! positive "${1:-}" || mem=$1
        ! positive "${2:-}" || nano=$2
        ! positive "${3:-}" || pids=$3
        docker stop "$c" >/dev/null
        docker rm "$c" >/dev/null
        # Sessions made before window managers were selectable run openbox
        run_container "$id" "$display" "$port" "${cmd:-$default_cmd}" "${geometry:-$default_geometry}" \
            "${wm:-openbox}" "$mem" "$nano" "$pids"
        ensure_up "$id"
        echo "raven: recreated session $id" >&2
    done
}

# Session backups: an uncompressed tar holding manifest.json, then home.tar.gz (the home
# volume packed with numeric owners). The python3 below runs in throwaway containers of a
# session image: with the home read-only to pack it, with nothing but the backup on stdin to
# check it, and with only the new home volume to unpack it. Its errors start with "raven:".
backup_helper() {
    cat <<'PYTHON'
import hashlib, io, json, os, re, stat, subprocess, sys, tarfile, threading, time

HOME, UID = b"/home/raven", 60000
LINE = re.compile(rb'(\S)\S{9} ([0-9]+)/([0-9]+) +\S+ [^"]* ("(?:[^"\\]|\\.)*")(?: (->|link to) ("(?:[^"\\]|\\.)*"))?')
KINDS = {b"c": "a character device", b"b": "a block device", b"p": "a FIFO", b"s": "a socket"}
ESCAPES = {b"a": b"\a", b"b": b"\b", b"f": b"\f", b"n": b"\n", b"r": b"\r", b"t": b"\t", b"v": b"\v"}


class Refused(Exception):
    pass


def show(path):
    return repr(path.decode("utf-8", "backslashreplace"))


def unquote(quoted):
    return re.sub(rb"\\([0-7]{1,3}|.)", lambda m: bytes([int(m[1], 8) & 255]) if m[1][:1].isdigit()
                  else ESCAPES.get(m[1], m[1]), quoted[1:-1])


def inside(path):
    """Components of a member path; an absolute path or a .. component leaves the home."""
    if not path or path.startswith(b"/") or b".." in path.split(b"/"):
        raise Refused(f"member {show(path)} points outside the home")
    return tuple(c for c in path.split(b"/") if c not in (b"", b"."))


def check_members(lines):
    """Check the tar -tv listing of a home archive; return (entries, entries not owned by UID)."""
    entries = foreign = 0
    links, files, paths = set(), set(), []
    for line in lines:
        m = LINE.fullmatch(line)
        if not m or (m[5] == b"->") != (m[1] == b"l") or (m[5] == b"link to") != (m[1] == b"h"):
            raise Refused("cannot read the member list of the home archive")
        name = unquote(m[4])
        path = inside(name)
        if m[1] not in b"-dlh":
            raise Refused(f"member {show(name)} is {KINDS.get(m[1], 'a special file')}; "
                          "only files, directories and links are restored")
        if m[1] == b"h":
            target = inside(unquote(m[6]))
            if target not in files:
                raise Refused(f"hard link {show(name)} points to {show(unquote(m[6]))}, "
                              "which is not a file earlier in the archive")
            paths.append(target)
        if not path and m[1] != b"d":
            raise Refused("the top of the home archive is not a directory")
        if path == (b"Downloads",) and m[1] != b"d":
            raise Refused("Downloads in the home archive is not a directory")
        if m[1] == b"l":
            links.add(path)
        if m[1] != b"d":
            files.add(path)
        paths.append(path)
        entries += 1
        foreign += int(m[2]) != UID or int(m[3]) != UID
    # A member under a symlink would be written wherever the link points
    for path in paths:
        for i in range(1, len(path)):
            if path[:i] in links:
                raise Refused(f"member {show(b'/'.join(path))} lies under the symbolic link "
                              f"{show(b'/'.join(path[:i]))}")
    if not entries:
        raise Refused("the home archive is empty")
    return entries, foreign


def tar(*arguments, **options):
    return subprocess.Popen(["tar", *arguments], env={"PATH": os.environ["PATH"], "LC_ALL": "C", "TZ": "UTC"},
                            **options)


def pump(source, sink):
    """Copy source to sink, which may stop reading early; return (bytes, sha256) of all of source."""
    digest, count, open_ = hashlib.sha256(), 0, True
    try:
        while chunk := source.read(1 << 20):
            digest.update(chunk)
            count += len(chunk)
            if open_:
                try:
                    sink.write(chunk)
                except BrokenPipeError:
                    open_ = False
    finally:
        try:
            sink.close()
        except BrokenPipeError:
            pass
    return count, digest.hexdigest()


def list_members(source):
    """Stream a home archive through tar -tv: (bytes, sha256, tar status, listing lines, tar errors)."""
    process = tar("-tvz", "--numeric-owner", "--full-time", "--quoting-style=c", "-f", "-",
                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out = {}
    readers = [threading.Thread(target=lambda: out.update(lines=process.stdout.read().splitlines()), daemon=True),
               threading.Thread(target=lambda: out.update(errors=process.stderr.read()), daemon=True)]
    for reader in readers:
        reader.start()
    count, digest = pump(source, process.stdin)
    for reader in readers:
        reader.join()
    return count, digest, process.wait(), out["lines"], out["errors"]


def text(value, where, empty=False):
    if not isinstance(value, str) or (not value and not empty) or len(value) > 4096 \
            or any(ord(c) < 32 or 127 <= ord(c) < 160 for c in value):
        raise Refused(f"manifest: {where} must be text without control characters")
    return value


def number(value, where):
    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
        raise Refused(f"manifest: {where} must be a whole number")
    return value


def section(manifest, key):
    if not isinstance(manifest.get(key), dict):
        raise Refused(f"manifest: {key} is missing")
    return manifest[key]


def no_duplicates(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise ValueError("duplicate key")
    return dict(pairs)


def not_a_number(constant):
    raise ValueError(constant)


def read_manifest(data):
    try:
        manifest = json.loads(data.decode("utf-8"), object_pairs_hook=no_duplicates, parse_constant=not_a_number)
    except ValueError:
        raise Refused("manifest.json is not valid JSON") from None
    if not isinstance(manifest, dict) or manifest.get("format") != "raven-session-backup":
        raise Refused("not a Raven session backup")
    version = manifest.get("version")
    if version != 1 or isinstance(version, bool):
        raise Refused(f"backup format version {version!r} is not supported (this raven reads version 1)")
    session, image, home = section(manifest, "session"), section(manifest, "image"), section(manifest, "home")
    info = {"user": text(manifest.get("user"), "user"), "host": text(manifest.get("host"), "host"),
            "created": text(manifest.get("created"), "created"), "id": text(session.get("id"), "session.id"),
            "name": "" if session.get("name") is None else text(session.get("name"), "session.name"),
            "cmd": text(session.get("cmd"), "session.cmd"), "wm": text(session.get("wm"), "session.wm"),
            "geometry": text(session.get("geometry"), "session.geometry"),
            "uid": text(session.get("uid"), "session.uid", empty=True),
            "image_tag": text(image.get("tag"), "image.tag", empty=True),
            "image_id": text(image.get("id"), "image.id"),
            "features": text(image.get("features"), "image.features", empty=True),
            "sha256": text(home.get("sha256"), "home.sha256"), "size": number(home.get("size"), "home.size"),
            "entries": number(home.get("entries"), "home.entries")}
    text(manifest.get("downloads"), "downloads")
    if home.get("file") != "home.tar.gz":
        raise Refused("manifest: home.file must be home.tar.gz")
    if not re.fullmatch(r"[0-9a-f]{64}", info["sha256"]):
        raise Refused("manifest: home.sha256 is not a sha256")
    if not re.fullmatch(r"[0-9]+", info["id"]):
        raise Refused("manifest: session.id must be a number")
    # The same rules as raven new -s
    if info["name"] and not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.-]*", info["name"]):
        raise Refused(f"manifest: session name {info['name']!r} must start with a letter and hold only letters, "
                      "digits, '_', '.', '-'")
    if info["wm"] not in ("xmonad", "openbox"):
        raise Refused(f"manifest: window manager must be xmonad or openbox: {info['wm']!r}")
    if not re.fullmatch(r"[0-9]+x[0-9]+", info["geometry"]):
        raise Refused(f"manifest: geometry must look like 1600x900: {info['geometry']!r}")
    return info


def open_backup():
    """The backup on stdin: an uncompressed tar of exactly manifest.json, then home.tar.gz."""
    archive = tarfile.open(fileobj=sys.stdin.buffer, mode="r|")
    first = archive.next()
    if first is None or first.name != "manifest.json" or first.type not in (tarfile.REGTYPE, tarfile.AREGTYPE):
        raise Refused("the first member must be the file manifest.json")
    if first.size > 1 << 20:
        raise Refused("manifest.json is larger than 1 MiB")
    info = read_manifest(archive.extractfile(first).read())
    second = archive.next()
    if second is None or second.name != "home.tar.gz" or second.type not in (tarfile.REGTYPE, tarfile.AREGTYPE):
        raise Refused("the second member must be the file home.tar.gz")
    if second.size != info["size"]:
        raise Refused(f"home.tar.gz is {second.size} bytes, the manifest says {info['size']}")
    return archive, second, info


def close_backup(archive, count, digest, info):
    if count != info["size"]:
        raise Refused("the backup file is truncated")
    if digest != info["sha256"]:
        raise Refused("home.tar.gz does not match the sha256 in the manifest; the file is damaged")
    if archive.next() is not None:
        raise Refused("the backup has members besides manifest.json and home.tar.gz")
    while rest := archive.fileobj.read(1 << 16):
        if rest.strip(b"\0"):
            raise Refused("the backup has data after its end")


def check():
    archive, member, info = open_backup()
    count, digest, status, lines, errors = list_members(archive.extractfile(member))
    close_backup(archive, count, digest, info)
    said = errors.decode("utf-8", "backslashreplace").strip().replace("\n", "; ")
    if status:
        raise Refused(f"the home archive is damaged ({said})")
    try:
        entries, foreign = check_members(lines)
    except Refused as error:
        raise Refused(f"{error} ({said})" if said else str(error)) from None
    # tar warns when it would change a name, e.g. strip ../ from a hard link target
    if said:
        raise Refused(f"the home archive has unsafe names ({said})")
    if entries != info["entries"]:
        raise Refused(f"the home archive has {entries} entries, the manifest says {info['entries']}")
    info["foreign"] = foreign
    for key, value in info.items():
        print(f"{key}={value}")


def fail(error):
    raise error


def extract(sha256):
    archive, member, info = open_backup()
    if info["sha256"] != sha256:
        raise Refused("the backup file changed after it was checked")
    process = tar("-C", HOME, "-xpz", "--numeric-owner", "-f", "-", stdin=subprocess.PIPE)
    count, digest = pump(archive.extractfile(member), process.stdin)
    status = process.wait()
    close_backup(archive, count, digest, info)
    if status:
        raise Refused("tar could not unpack the home")
    # Where the shared ~/Downloads is mounted, as in a new session's home
    os.makedirs(HOME + b"/Downloads", 0o755, exist_ok=True)
    # The session user owns its whole home; modes stay as they were
    for top, directories, files in os.walk(HOME, onerror=fail):
        for path in [top] + [os.path.join(top, n) for n in directories + files]:
            st = os.lstat(path)
            if st.st_uid != UID or st.st_gid != UID:
                os.lchown(path, UID, UID)


def backup(user, host, created, sid, name, cmd, wm, geometry, uid, tag, image_id, features):
    keep, skipped = [], []
    for top, directories, files in os.walk(HOME, onerror=fail):
        directories.sort()
        here = b"." + top[len(HOME):]
        keep.append(here)
        # Symlinks to directories are listed with the directories but not walked into
        for n in sorted(files + [d for d in directories if os.path.islink(os.path.join(top, d))]):
            mode = os.lstat(os.path.join(top, n)).st_mode
            (keep if stat.S_ISREG(mode) or stat.S_ISLNK(mode) else skipped).append(here + b"/" + n)
    if skipped:
        print(f"raven: left out {len(skipped)} special file(s) (sockets, FIFOs, devices), which a restore refuses: "
              + ", ".join(show(p) for p in skipped[:5]) + (", ..." if len(skipped) > 5 else ""), file=sys.stderr)
    process = tar("-C", HOME, "--null", "--verbatim-files-from", "--no-recursion", "-T", "-", "--numeric-owner",
                  "-czf", "/tmp/home.tar.gz", stdin=subprocess.PIPE)
    process.communicate(b"".join(p + b"\0" for p in keep))
    if process.returncode:
        raise Refused("tar could not pack the home")
    size = os.path.getsize("/tmp/home.tar.gz")
    with open("/tmp/home.tar.gz", "rb") as source:
        count, digest, status, lines, errors = list_members(source)
    if status or errors or count != size:
        raise Refused("cannot read back the home archive")
    entries, _ = check_members(lines)
    manifest = {"format": "raven-session-backup", "version": 1, "created": created, "user": user, "host": host,
                "session": {"id": sid, "name": name or None, "cmd": cmd, "wm": wm, "geometry": geometry, "uid": uid},
                "image": {"tag": tag, "id": image_id, "features": features},
                "home": {"file": "home.tar.gz", "sha256": digest, "size": size, "entries": entries},
                "downloads": "not included"}
    data = (json.dumps(manifest, indent=2, ensure_ascii=False) + "\n").encode()
    with tarfile.open(fileobj=sys.stdout.buffer, mode="w|", format=tarfile.GNU_FORMAT) as archive, \
            open("/tmp/home.tar.gz", "rb") as home:
        for member, length, source in (("manifest.json", len(data), io.BytesIO(data)), ("home.tar.gz", size, home)):
            entry = tarfile.TarInfo(member)
            entry.size, entry.mode, entry.mtime = length, 0o600, int(time.time())
            archive.addfile(entry, source)


try:
    {"check": check, "extract": extract, "backup": backup}[sys.argv[1]](*sys.argv[2:])
except Refused as error:
    print(f"raven: {error}", file=sys.stderr)
    sys.exit(3)
except (tarfile.TarError, EOFError) as error:
    print(f"raven: the backup file is truncated or not a tar archive ({error})", file=sys.stderr)
    sys.exit(3)
PYTHON
}

# docker run of the backup helper: OPTIONS... IMAGE -c "$(backup_helper)" ARGS...
# --log-driver none keeps the archive streams out of docker's container logs.
run_helper() {
    docker run --rm --network none --log-driver none --entrypoint python3 "$@"
}

# Bytes as KiB below 1 MiB, else as size_text does
file_size_text() {
    if [ "$1" -lt 1048576 ]; then echo "$((($1 + 1023) / 1024))KiB"; else size_text "$1"; fi
}

backup_tmp= backup_restart= backup_unpause=
# On an exit before the backup is finished: drop the partial file, and start the session
# again when the backup stopped it
backup_cleanup() {
    local rc=$?
    [ -z "$backup_tmp" ] || rm -f "$backup_tmp"
    if [ -n "$backup_unpause" ]; then
        if docker unpause "$(cname "$backup_unpause")" >/dev/null 2>&1; then
            echo "raven: session $backup_unpause continues" >&2
        else
            echo "raven: session $backup_unpause is still frozen; continue it with: raven resume $backup_unpause" >&2
        fi
    fi
    if [ -n "$backup_restart" ]; then
        if docker start "$(cname "$backup_restart")" >/dev/null 2>&1; then
            echo "raven: session $backup_restart started again" >&2
        else
            echo "raven: session $backup_restart did not start again; start it with: raven attach $backup_restart" >&2
        fi
    fi
    exit "$rc"
}

cmd_backup() {
    local target= out= stop=0 usage='usage: raven backup [-t] TARGET [-o FILE] [--stop]'
    local id c state name cmd geometry wm img now tmp size entries freeze=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -t | -o)
                [ $# -ge 2 ] || die "$1 needs an argument"
                if [ "$1" = -t ]; then target=$2; else out=$2; fi
                shift 2 ;;
            --stop) stop=1; shift ;;
            -*) die "$usage" ;;
            *) [ -z "$target" ] || die "$usage"; target=$1; shift ;;
        esac
    done
    [ -n "$target" ] || die "$usage"
    id=$(resolve "$target")
    c=$(cname "$id")
    state=$(field "$id" 4)
    # Files that apps are still writing would not match each other in the backup: freeze them
    # while the home is read (or stop them with --stop); a paused session is frozen already
    case "$state" in
        paused) ;;
        running) [ "$stop" = 1 ] || freeze=1 ;;
        restarting)
            [ "$stop" = 1 ] || die "session $id is restarting; back it up when it runs, or stopped with:" \
                "raven backup $id --stop" ;;
        *) stop=0 ;;
    esac
    docker volume inspect "$(vname "$id")" >/dev/null 2>&1 || die "session $id has no home volume $(vname "$id")"
    name=$(name_of "$id")
    now=$(date -u +%s)
    if [ -z "$out" ]; then
        # The backup holds the session's files (browser profiles, keys): only the owner reads it
        (umask 077 && mkdir -p "$backupdir") || die "cannot create $backupdir"
        chmod 700 "$backupdir"
        out=$backupdir/session-$id-${name:-noname}-$(date -u -d "@$now" +%Y%m%dT%H%M%SZ).tar
    fi
    [ ! -e "$out" ] && [ ! -L "$out" ] || die "$out already exists"
    cmd=$(label_of "$c" raven.cmd)
    geometry=$(label_of "$c" raven.geometry)
    wm=$(label_of "$c" raven.wm)
    img=$(docker inspect -f '{{.Image}}' "$c")

    # Written under a temporary name next to the file (mktemp makes it 0600), renamed when complete
    tmp=$(mktemp "$(dirname -- "$out")/.$(basename -- "$out").XXXXXX") || die "cannot write in $(dirname -- "$out")"
    backup_tmp=$tmp
    trap backup_cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    if [ "$stop" = 1 ]; then
        echo "raven: stopping session $id${name:+ ($name)} for the backup; its apps end and unsaved work in them is lost" >&2
        backup_restart=$id
        [ "$state" != paused ] || docker unpause "$c" >/dev/null
        docker stop "$c" >/dev/null
    elif [ "$freeze" = 1 ]; then
        echo "raven: freezing session $id${name:+ ($name)} while its home is read; its apps and viewers continue afterwards" >&2
        backup_unpause=$id
        docker pause "$c" >/dev/null || die "session $id could not be frozen; nothing was backed up"
    elif [ "$state" = paused ]; then
        echo "raven: session $id${name:+ ($name)} is paused; its files are backed up as they are and it stays paused" >&2
    fi
    # Sessions made before window managers were selectable run openbox
    run_helper --user 0 --mount "type=volume,src=$(vname "$id"),dst=/home/raven,readonly,volume-nocopy" \
        "$img" -c "$(backup_helper)" backup "$user" "$(hostname)" "$(date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ)" \
        "$id" "$name" "${cmd:-$default_cmd}" "${wm:-openbox}" "${geometry:-$default_geometry}" \
        "$(label_of "$c" raven.uid)" "$(docker inspect -f '{{.Config.Image}}' "$c")" "$img" \
        "$(label_of "$c" raven.features)" > "$tmp" || die "session $id was not backed up"
    if [ -n "$backup_unpause" ]; then
        backup_unpause=
        docker unpause "$c" >/dev/null || die "session $id is still frozen; continue it with: raven resume $id"
    fi
    entries=$(tar -xOf "$tmp" manifest.json | sed -n 's/^ *"entries": \([0-9]*\).*/\1/p') \
        && [ -n "$entries" ] || die "session $id was not backed up: cannot read back $tmp"
    chmod 600 "$tmp"
    # A hard link never replaces a file that appeared meanwhile; mv where links are not supported
    if ln -T -- "$tmp" "$out" 2>/dev/null; then
        rm -f "$tmp"
    else
        [ ! -e "$out" ] && [ ! -L "$out" ] || die "$out already exists"
        mv -T -- "$tmp" "$out" || die "cannot rename $tmp to $out"
    fi
    backup_tmp=
    size=$(stat -c %s "$out")
    echo "raven: backed up session $id${name:+ ($name)}: $entries entries, $(file_size_text "$size")" >&2
    echo "raven: ~/Downloads is not included; it is a shared host folder, not part of the session home" >&2
    echo "raven: the file is not encrypted; only you can read it (mode 600)" >&2
    if [ "$freeze" = 1 ] || { [ "$state" = paused ] && [ "$stop" = 0 ]; }; then
        echo "raven: the backup is like a power cut at that moment: work that apps held only in memory is not in it" >&2
    fi
    printf '%s\n' "$out"
    if [ -n "$backup_restart" ]; then
        backup_restart=
        ensure_up "$id"
        echo "raven: started session $id again; its start command ran anew" >&2
    fi
    trap - EXIT HUP INT TERM
}

restore_id=
# On an exit before the restored session is up: remove what restore made for it
restore_cleanup() {
    local rc=$?
    if [ -n "$restore_id" ]; then
        docker rm -f "$(cname "$restore_id")" >/dev/null 2>&1 || true
        docker volume rm "$(vname "$restore_id")" >/dev/null 2>&1 || true
        rm -f "$statedir/$restore_id.name" "$statedir/$restore_id.home" \
            "$rundir/$restore_id.xauth" "$rundir/$restore_id.log"
        echo "raven: removed the unfinished session $restore_id; nothing else was changed" >&2
    fi
    exit "$rc"
}

cmd_restore() {
    local file= name= wm= geometry= usage='usage: raven restore FILE [-s NAME] [-w WM] [-g WxH] [-m SIZE] [-c CPUS] [CMD...]'
    local info from owner made current foreign cmd i id d p mem_set=0 mem= cpus_set=0 cpus= limits
    while [ $# -gt 0 ]; do
        case "$1" in
            -s | -w | -g | -m | -c)
                [ $# -ge 2 ] || die "$1 needs an argument"
                case "$1" in
                    -s) name=$2 ;;
                    -w) wm=$2 ;;
                    -m) mem_set=1 mem=$2 ;;
                    -c) cpus_set=1 cpus=$2 ;;
                    *) geometry=$2 ;;
                esac
                shift 2 ;;
            --) shift; break ;;
            -*) die "$usage" ;;
            *) [ -z "$file" ] || break; file=$1; shift ;;
        esac
    done
    if [ -z "$file" ] && [ $# -gt 0 ]; then
        file=$1
        shift
    fi
    [ -n "$file" ] || die "$usage"
    [ -f "$file" ] && [ -r "$file" ] || die "cannot read $file"
    [ -z "$wm" ] || check_wm "$wm"
    [ -z "$geometry" ] || check_geometry "$geometry"
    [ -z "$name" ] || check_name "$name"
    # Limits are not in backups: -m and -c, else the defaults of new
    limits=$(new_limits "$mem_set" "$mem" "$cpus_set" "$cpus") || exit $?
    need_image

    # Everything is checked before anything is made. The file goes in on stdin: through a bind
    # mount a container could not read a 0600 file on an NFS home.
    info=$(run_helper -i "$image" -c "$(backup_helper)" check < "$file") \
        || die "$file was not restored; nothing was created"
    from=$(restore_info "$info" name)
    [ -n "$wm" ] || wm=$(restore_info "$info" wm)
    check_wm "$wm"
    [ -n "$geometry" ] || geometry=$(restore_info "$info" geometry)
    check_geometry "$geometry"
    cmd=${*:-$(restore_info "$info" cmd)}
    if [ -z "$name" ] && [ -n "$from" ]; then
        for i in $(ids); do
            [ "$(name_of "$i")" != "$from" ] \
                || die "name '$from' from the backup is used by session $i; give another with: raven restore FILE -s NAME"
        done
        check_name "$from"
        name=$from
    fi
    owner=$(restore_info "$info" user)
    echo "raven: backup of session $(restore_info "$info" id)${from:+ ($from)} made by $owner" \
        "on $(restore_info "$info" host) at $(restore_info "$info" created)" >&2
    [ "$owner" = "$user" ] || echo "raven: warning: the backup belongs to user $owner, not $user" >&2
    made=$(restore_info "$info" image_id)
    current=$(docker image inspect -f '{{.Id}}' "$image")
    [ "$made" = "$current" ] \
        || echo "raven: warning: the backup was made with image $(restore_info "$info" image_tag)" \
            "($(echo "$made" | cut -c 1-19)); the session gets the current $image ($(echo "$current" | cut -c 1-19))" >&2
    foreign=$(restore_info "$info" foreign)
    [ "$foreign" = 0 ] \
        || echo "raven: warning: $foreign entries belong to other users; they are given to the session user 60000" >&2

    id=$(free_id)
    d=$(free_display)
    p=$((port_base + d - display_base))
    # docker volume create would reuse a volume that another raven made meanwhile
    if docker volume inspect "$(vname "$id")" >/dev/null 2>&1; then
        die "home volume $(vname "$id") appeared meanwhile; nothing was created, try again"
    fi
    trap restore_cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    docker volume create "$(vname "$id")" >/dev/null
    restore_id=$id
    # A root helper unpacks into the new volume, without the image's home copied in first, and
    # gives every entry to the session user; the content must still match the checked sha256
    run_helper -i --user 0 --mount "type=volume,src=$(vname "$id"),dst=/home/raven,volume-nocopy" \
        "$image" -c "$(backup_helper)" extract "$(restore_info "$info" sha256)" < "$file" \
        || die "$file was not restored"
    mkdir -p "$HOME/Downloads" "$statedir"
    rm -f "$statedir/$id.name" "$statedir/$id.home"
    [ -z "$name" ] || echo "$name" > "$statedir/$id.name"
    # shellcheck disable=SC2086
    run_container "$id" "$d" "$p" "$cmd" "$geometry" "$wm" $limits "$session_pids"
    ensure_up "$id"
    restore_id=
    trap - EXIT HUP INT TERM
    echo "raven: restored session $id${name:+ ($name)} with $wm, $geometry: $cmd" >&2
    # shellcheck disable=SC2086
    echo "raven: $(limits_summary $limits)" >&2
    echo "raven: ~/Downloads was not in the backup; the session shares the current ~/Downloads" >&2
    echo "raven: attach with: raven attach $id" >&2
}

# Value of KEY in the KEY=VALUE lines of a checked backup (values have no line breaks)
restore_info() {
    printf '%s\n' "$1" | sed -n "s/^$2=//p"
}

enabled_addons() {
    if [ -f "$confdir/addons.enabled" ]; then
        grep -vE '^[[:space:]]*(#|$)' "$confdir/addons.enabled" || true
    else
        echo "$default_addons"
    fi
}

# A user addon shadows a built-in one with the same name
addon_dir() {
    if [ -f "$confdir/addons/$1/addon.conf" ]; then
        echo "$confdir/addons/$1"
    elif [ -f "$srcdir/addons/$1/addon.conf" ]; then
        echo "$srcdir/addons/$1"
    else
        return 1
    fi
}

# Print DESCRIPTION, SECCOMP, SHM_SIZE and SESSION_ENV of an addon, tab separated
addon_info() {
    (
        DESCRIPTION= SECCOMP= SHM_SIZE= SESSION_ENV=
        . "$1/addon.conf"
        printf '%s\t%s\t%s\t%s\n' "$DESCRIPTION" "$SECCOMP" "$SHM_SIZE" "$SESSION_ENV"
    )
}

# Turn an addon's SESSION_ENV ("NAME=VALUE ...") into Dockerfile ENV arguments
session_env() {
    local a=$1 kv
    set -f
    for kv in $2; do
        case "$kv" in
            [A-Za-z_]*=*) ;;
            *) die "addon $a: SESSION_ENV entries must look like NAME=VALUE: '$kv'" ;;
        esac
        case "${kv%%=*}" in
            *[!A-Za-z0-9_]*) die "addon $a: bad variable name in SESSION_ENV: '$kv'" ;;
        esac
        case "${kv#*=}" in
            *[\"\\\$]*) die "addon $a: SESSION_ENV values may not contain quotes, backslashes or \$: '$kv'" ;;
        esac
        printf ' %s="%s"' "${kv%%=*}" "${kv#*=}"
    done
    set +f
}

to_mib() {
    echo "$1" | awk '{
        n = $0 + 0; u = tolower(substr($0, length($0)))
        if (u == "g") n *= 1024; else if (u == "k") n /= 1024; else if (u != "m") n /= 1048576
        printf "%d\n", n
    }'
}

cmd_build() {
    local a dir info names= seccomp= shm=0 env=
    docker build -t "$core_image" "$@" "$srcdir"

    # --pull would try to fetch the local core image from a registry
    for a in "$@"; do
        shift
        [ "$a" = --pull ] || set -- "$@" "$a"
    done

    ctx=$(mktemp -d)
    trap 'rm -rf "$ctx"' EXIT
    {
        echo "FROM $core_image"
        echo "USER root"
    } > "$ctx/Dockerfile"
    for a in $(enabled_addons); do
        dir=$(addon_dir "$a") || die "addon not found: $a (see: raven addon ls)"
        info=$(addon_info "$dir")
        [ "$(echo "$info" | cut -f 2)" != unconfined ] || seccomp=unconfined
        if [ -n "$(echo "$info" | cut -f 3)" ] && [ "$(to_mib "$(echo "$info" | cut -f 3)")" -gt "$shm" ]; then
            shm=$(to_mib "$(echo "$info" | cut -f 3)")
        fi
        env="$env$(session_env "$a" "$(echo "$info" | cut -f 4)")"
        names="$names${names:+ }$a"
        echo "RUN --mount=type=bind,from=addon-$a,target=/tmp/raven-addon raven-apply-addon $a /tmp/raven-addon" \
            >> "$ctx/Dockerfile"
        set -- "$@" --build-context "addon-$a=$dir"
    done
    [ "$shm" -gt 0 ] && shm=${shm}m || shm=
    {
        # Image ENV reaches every session process: the entrypoint, menu apps and docker exec
        [ -z "$env" ] || echo "ENV$env"
        echo "LABEL raven.addons=\"$names\" raven.seccomp=\"$seccomp\" raven.shm-size=\"$shm\""
        echo "USER raven"
    } >> "$ctx/Dockerfile"
    docker build -t "$image" -f "$ctx/Dockerfile" "$@" "$ctx"
    echo "raven: built $image with addons: ${names:-(none)}" >&2
    echo "raven: move existing sessions onto it with: raven recreate -a" >&2
}

cmd_addon() {
    local sub=${1:-ls} built enabled n dir info src
    [ $# -eq 0 ] || shift
    case "$sub" in
        ls)
            built=$(docker image inspect -f '{{index .Config.Labels "raven.addons"}}' "$image" 2>/dev/null || true)
            enabled=$(enabled_addons)
            printf '%-16s %-8s %-6s %-8s %s\n' NAME ENABLED BUILT SOURCE DESCRIPTION
            for n in $( (ls "$srcdir/addons" 2>/dev/null; ls "$confdir/addons" 2>/dev/null) | sort -u); do
                dir=$(addon_dir "$n") || continue
                info=$(addon_info "$dir")
                case "$dir" in "$confdir"/*) src=user ;; *) src=builtin ;; esac
                printf '%-16s %-8s %-6s %-8s %s\n' "$n" \
                    "$(echo "$enabled" | grep -qx "$n" && echo yes || echo no)" \
                    "$(echo " $built " | grep -q " $n " && echo yes || echo no)" \
                    "$src" "$(echo "$info" | cut -f 1)"
            done ;;
        enable)
            [ $# -eq 1 ] || die "usage: raven addon enable NAME"
            addon_dir "$1" >/dev/null || die "addon not found: $1"
            enabled=$(enabled_addons)
            mkdir -p "$confdir"
            { echo "$enabled"; echo "$enabled" | grep -qx "$1" || echo "$1"; } \
                | grep -v '^$' > "$confdir/addons.enabled"
            echo "raven: enabled $1; apply with: raven build && raven recreate -a" >&2 ;;
        disable)
            [ $# -eq 1 ] || die "usage: raven addon disable NAME"
            enabled=$(enabled_addons)
            mkdir -p "$confdir"
            echo "$enabled" | grep -vx "$1" > "$confdir/addons.enabled" || true
            echo "raven: disabled $1; apply with: raven build && raven recreate -a" >&2 ;;
        new)
            [ $# -ge 1 ] || die "usage: raven addon new NAME [PKG...]"
            n=$1
            shift
            case "$n" in
                [a-z0-9]*) ;;
                *) die "addon name must start with a lowercase letter or digit: '$n'" ;;
            esac
            case "$n" in
                *[!a-z0-9_.-]*) die "addon name may only contain a-z, 0-9, '_', '.', '-': '$n'" ;;
            esac
            dir=$confdir/addons/$n
            [ ! -e "$dir" ] || die "already exists: $dir"
            mkdir -p "$dir"
            printf 'DESCRIPTION="%s"\nPACKAGES="%s"\n' "$n" "$*" > "$dir/addon.conf"
            echo "raven: created $dir/addon.conf" >&2
            echo "raven: next: raven addon enable $n && raven build && raven recreate -a" >&2 ;;
        *) die "usage: raven addon ls | enable NAME | disable NAME | new NAME [PKG...]" ;;
    esac
}

menu_template() {
    cat <<'EOF'
# raven menu rules, applied after the image defaults (/etc/raven/menu.d/*.conf).
#   LABEL = COMMAND    add an entry at the top, or change the command of LABEL
#   LABEL = @COMMAND   same, but COMMAND runs on the host (raven run @LABEL also works)
#   !LABEL             hide an entry (also hides generated .desktop entries)
#   ---                separator
# Examples:
#   term = @wezterm start --always-new-process
#   Edge (work) = microsoft-edge --profile-directory=Work
#   !Microsoft Edge
EOF
}

cmd_menu() {
    local sub=${1:-show} target= id
    [ $# -eq 0 ] || shift
    case "$sub" in
        edit)
            mkdir -p "$confdir"
            [ -f "$confdir/menu.conf" ] || menu_template > "$confdir/menu.conf"
            # shellcheck disable=SC2086
            set -- ${VISUAL:-${EDITOR:-vi}}
            # Skip the user's vimrc and plugins
            case "$(readlink -f "$(command -v "$1")" 2>/dev/null)" in
                */vim | */vim.* | */nvim) set -- "$@" --clean ;;
            esac
            "$@" "$confdir/menu.conf"
            cmd_menu sync ;;
        show)
            [ "${1:-}" != -t ] || { target=${2:-}; shift 2; }
            target=${target:-${1:-}}
            id=$(resolve "$target")
            ensure_up "$id"
            xin "$id" raven-menu --list ;;
        sync)
            for id in $(sessions | awk '$4 == "running" { print $1 }'); do
                push_menu "$id"
            done ;;
        *) die "usage: raven menu edit | show [-t TARGET] | sync" ;;
    esac
}

check_image() {
    [ -f "$1" ] && [ -r "$1" ] || die "cannot read image: $1"
    case "$(od -An -tx1 -N4 < "$1" | tr -d ' \n')" in
        89504e47 | ffd8ff*) ;;
        *) die "wallpaper must be a PNG or JPEG file: $1" ;;
    esac
}

# Text read from a session is untrusted: keep printable characters only
wallpaper_summary() {
    local s
    s=$(printf '%s\n' "$1" | tr -cd '[:print:]\n')
    case "$(printf '%s\n' "$s" | sed -n 's/^type=//p')" in
        image) printf 'image (%s)\n' "$(printf '%s\n' "$s" | sed -n 's/^mode=//p')" ;;
        color) printf 'color %s\n' "$(printf '%s\n' "$s" | sed -n 's/^color=//p')" ;;
        *) printf '(invalid)\n' ;;
    esac
}

# Store CONF (and IMG) for every session when TARGET is empty, else for that session only.
# An empty CONF clears the setting.
save_wallpaper() {
    local target="$1" conf="$2" img="$3" ids id c n=0 skipped=0 failed=0 rc
    if [ -z "$target" ]; then
        ids=$(sessions) || die "cannot list sessions"
        mkdir -p "$confdir" || die "cannot create $confdir"
        if [ -z "$conf" ]; then
            rm -f "$confdir/wallpaper.conf" "$confdir/wallpaper.img"
        else
            # Write both files aside first, so a full disk leaves the old setting in place
            if [ -n "$img" ]; then
                cp -- "$img" "$confdir/wallpaper.img.tmp" || { rm -f "$confdir/wallpaper.img.tmp"; die "cannot store $img"; }
            fi
            printf '%s\n' "$conf" > "$confdir/wallpaper.conf.tmp" \
                || { rm -f "$confdir/wallpaper.img.tmp" "$confdir/wallpaper.conf.tmp"; die "cannot store the setting"; }
            # Same order as in sessions: drop the conf, replace the image, then put the conf
            rm -f "$confdir/wallpaper.conf"
            if [ -n "$img" ]; then
                mv -f "$confdir/wallpaper.img.tmp" "$confdir/wallpaper.img" || die "cannot store $img"
            else
                rm -f "$confdir/wallpaper.img"
            fi
            mv -f "$confdir/wallpaper.conf.tmp" "$confdir/wallpaper.conf" || die "cannot store the setting"
        fi
        for id in $(echo "$ids" | awk '$4 == "running" { print $1 }'); do
            if push_wallpaper "$id"; then
                n=$((n + 1))
            else
                rc=$?
                if [ "$rc" -eq 2 ]; then
                    skipped=$((skipped + 1))
                else
                    failed=$((failed + 1))
                    echo "raven: session $id: wallpaper not updated" >&2
                fi
            fi
        done
        printf 'raven: applied to %s running session(s)' "$n" >&2
        [ "$skipped" -eq 0 ] || printf '; %s older session(s) get it after recreate' "$skipped" >&2
        [ "$failed" -eq 0 ] || printf '; %s failed' "$failed" >&2
        printf '\n' >&2
        [ "$failed" -eq 0 ]
        return
    fi

    id=$(resolve "$target")
    has_wallpaper "$id" || die "session $id runs an image without wallpaper support; recreate it first"
    ensure_up "$id"
    c=$(cname "$id")
    if [ -z "$conf" ]; then
        docker exec "$c" rm -f /home/raven/.config/raven/wallpaper.local.conf /home/raven/.config/raven/wallpaper.local.img \
            || die "session $id: cannot clear its wallpaper"
    else
        put_wallpaper "$c" wallpaper.local "$conf" "$img" || die "session $id: cannot store its wallpaper"
    fi
    apply_wallpaper "$id"
}

cmd_wallpaper() {
    local sub=${1:-show} target= mode= opt id own name sha
    [ $# -eq 0 ] || shift
    OPTIND=1
    while getopts t:m: opt; do
        case "$opt" in
            t) target=$OPTARG ;;
            m) mode=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    case "$sub" in
        set) ;;
        color | clear) [ -z "$mode" ] || die "-m only applies to wallpaper set" ;;
        show) [ -z "$mode$target" ] && [ $# -eq 0 ] || die "usage: raven wallpaper show" ;;
    esac
    case "$sub" in
        set)
            [ $# -eq 1 ] || die "usage: raven wallpaper set [-t TARGET] [-m MODE] FILE"
            mode=${mode:-zoom}
            case "$mode" in
                zoom | maximize | center | tile | stretch | focus) ;;
                *) die "mode must be zoom, maximize, center, tile, stretch or focus: '$mode'" ;;
            esac
            check_image "$1"
            sha=$(sha256sum < "$1") || die "cannot read image: $1"
            save_wallpaper "$target" "$(printf 'type=image\nmode=%s\nsha=%s' "$mode" "${sha%% *}")" "$1" ;;
        color)
            [ $# -eq 1 ] || die "usage: raven wallpaper color [-t TARGET] '#rrggbb'"
            case "$1" in
                \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
                *) die "color must look like '#24303c': '$1'" ;;
            esac
            save_wallpaper "$target" "$(printf 'type=color\ncolor=%s' "$1")" "" ;;
        clear)
            [ $# -eq 0 ] || die "usage: raven wallpaper clear [-t TARGET]"
            save_wallpaper "$target" "" "" ;;
        show)
            if [ -f "$confdir/wallpaper.conf" ]; then
                echo "all sessions: $(wallpaper_summary "$(cat "$confdir/wallpaper.conf")")"
            else
                echo "all sessions: (none)"
            fi
            # Only running sessions can be asked for their own setting
            for id in $(sessions | awk '$4 == "running" { print $1 }' | sort -n); do
                has_wallpaper "$id" || continue
                own=$(docker exec "$(cname "$id")" cat /home/raven/.config/raven/wallpaper.local.conf 2>/dev/null) \
                    || continue
                [ -n "$own" ] || continue
                name=$(name_of "$id")
                printf 'session %s%s: %s\n' "$id" "${name:+ ($name)}" "$(wallpaper_summary "$own")"
            done ;;
        *) die "usage: raven wallpaper set|color|clear [-t TARGET] ... | show" ;;
    esac
}

# Copy changed home files into session $1 and let a running session's hooks reload
sync_home() {
    local rc=0
    push_home "$1" || rc=$?
    case "$rc" in
        0) [ "$(field "$1" 4)" != running ] || reload_session "$1" \
               || echo "raven: session $1: session hooks failed" >&2 ;;
        2) echo "raven: session $1: home files not updated" >&2; return 1 ;;
    esac
}

cmd_home() {
    local target= opt id failed=0
    [ "${1:-}" = sync ] || die "usage: raven home sync [-t TARGET]"
    shift
    OPTIND=1
    while getopts t: opt; do
        case "$opt" in
            t) target=$OPTARG ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    [ $# -eq 0 ] || die "usage: raven home sync [-t TARGET]"
    if [ -n "$target" ]; then
        id=$(resolve "$target")
        refuse_paused "$id"
        sync_home "$id"
        return
    fi
    # Stopped sessions get the files at their next start; paused ones at the next attach or run
    for id in $(sessions | awk '$4 == "running" { print $1 }'); do
        sync_home "$id" || failed=1
    done
    [ "$failed" = 0 ]
}

doctor_bad=0
report() {
    printf '%-5s %s\n' "$1" "$2"
    [ "$1" != fail ] || doctor_bad=1
}

# Check what the server needs (docs/install.md) without changing anything
cmd_doctor() {
    local v t missing= uid members old= stale= cur id c pid age
    [ $# -eq 0 ] || die "usage: raven doctor"
    if v=$(docker version --format '{{.Server.Version}}' 2>/dev/null); then
        report ok "docker $v"
    else
        report fail "docker: cannot reach the daemon (is $(id -un) in the docker group?)"
    fi
    if v=$(docker buildx version 2>/dev/null); then
        report ok "buildx $(echo "$v" | awk '{ print $2 }')"
    else
        report fail "docker buildx (BuildKit) is missing; raven build needs it"
    fi
    for t in python3 xauth ss tar find sha256sum setsid mktemp readlink hostname awk sed; do
        command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
    done
    if [ -n "$missing" ]; then
        report fail "missing host tools:$missing"
    elif ! tar --version 2>/dev/null | head -n 1 | grep -q GNU; then
        report fail "tar is not GNU tar (raven uses --sort and --no-overwrite-dir)"
    else
        report ok "host tools"
    fi

    if docker image inspect "$image" >/dev/null 2>&1; then
        uid=$(docker image inspect -f '{{index .Config.Labels "raven.uid"}}' "$image")
        report ok "image $image (addons: $(docker image inspect -f '{{index .Config.Labels "raven.addons"}}' "$image"))"
        [ -n "$uid" ] || report warn "image $image predates the separate session uid; run: raven build"
    else
        report warn "image $image is not built; run: raven build"
    fi
    if t=$(getent passwd "${uid:-60000}"); then
        report warn "uid ${uid:-60000} is the host account ${t%%:*}; files sessions make in ~/Downloads belong to it"
    else
        report ok "session uid ${uid:-60000} has no host account"
    fi
    members=$(getent group "$(id -g)" | cut -d: -f4)
    case ",$members," in
        ,, | ",$(id -un),") report ok "primary group $(id -gn) has no other members" ;;
        *) report warn "primary group $(id -gn) also has $members; they can write ~/Downloads" ;;
    esac
    if [ -d "$HOME/Downloads" ] && [ -g "$HOME/Downloads" ] && [ -n "$(find "$HOME/Downloads" -maxdepth 0 -perm -g+w)" ]; then
        report ok "~/Downloads is group-writable with setgid"
    else
        report info "~/Downloads gets g+rwxs when a session is created"
    fi

    cur=$(docker image inspect -f '{{.Id}}' "$image" 2>/dev/null || true)
    for id in $(ids | sort -n); do
        c=$(cname "$id")
        [ -n "$(label_of "$c" raven.uid)" ] || old="$old $id"
        [ "$(docker inspect -f '{{.Image}}' "$c")" = "$cur" ] || stale="$stale $id"
    done
    [ -z "$old" ] || report warn "sessions from before the separate session uid:$old (raven recreate)"
    [ -z "$stale" ] || report info "sessions not on the current $image:$stale (raven recreate to update)"

    pid=$(hostd_pid)
    if [ -z "$pid" ]; then
        report info "host relay is not running; attach, run and shell start it"
    elif ! tr '\0' ' ' < "/proc/$pid/cmdline" | grep -qF "$srcdir/raven-hostd"; then
        report warn "host relay (pid $pid) belongs to another raven: $(tr '\0' ' ' < "/proc/$pid/cmdline"); raven hostd stop"
    else
        age=$(ps -o etimes= -p "$pid" | tr -d ' ')
        if [ $(($(date +%s) - age)) -lt "$(stat -c %Y "$srcdir/raven-hostd")" ]; then
            report warn "host relay (pid $pid) started before raven-hostd changed; raven hostd stop"
        else
            report ok "host relay running (pid $pid)"
        fi
    fi

    if [ -z "${DISPLAY:-}" ]; then
        report warn "DISPLAY is not set; attach needs X11 forwarding (ssh -Y)"
    elif [ -n "$(xauth list "$DISPLAY" 2>/dev/null)" ]; then
        report ok "DISPLAY $DISPLAY with an X cookie"
    else
        report warn "DISPLAY $DISPLAY has no X cookie; the viewer connects only if the X server allows it"
    fi
    report info "session time zone: $(host_tz)"
    if command -v systemctl >/dev/null 2>&1; then
        if [ "$(systemctl is-enabled docker 2>/dev/null)" = enabled ]; then
            report ok "docker starts at boot"
        else
            report warn "docker is not enabled at boot; sessions do not come back after a reboot"
        fi
    fi
    return "$doctor_bad"
}

# Remove this user's raven from the server: sessions with their homes, names, runtime files
# and the relay; --config also ~/.config/raven, --images the images no other session uses
cmd_uninstall() {
    local yes=0 dry=0 config=0 images=0 list vols answer img id v
    while [ $# -gt 0 ]; do
        case "$1" in
            -y | --yes) yes=1 ;;
            -n | --dry-run) dry=1 ;;
            --config) config=1 ;;
            --images) images=1 ;;
            *) die "usage: raven uninstall [-y] [-n] [--config] [--images]" ;;
        esac
        shift
    done
    list=$(ids | sort -n | tr '\n' ' ' | sed 's/ $//')
    # Homes left behind by containers removed outside raven
    vols=$(docker volume ls -q | awk -v p="raven-$user-home-" \
        'index($0, p) == 1 && substr($0, length(p) + 1) ~ /^[0-9]+$/' | tr '\n' ' ' | sed 's/ $//')
    echo "raven uninstall removes:"
    echo "  sessions (containers): ${list:-none}"
    echo "  home volumes: ${vols:-none}"
    echo "  $statedir, $rundir and the host relay"
    [ "$config" = 0 ] || echo "  $confdir (menu, wallpaper, addons, personal files)"
    [ "$images" = 0 ] || echo "  images $image, $core_image unless another session uses them"
    echo "kept: ~/Downloads and its files, session backups in $backupdir, the raven checkout, ~/.local/bin/raven"
    [ "$dry" = 0 ] || return 0
    if [ "$yes" = 0 ]; then
        [ -t 0 ] || die "stdin is not a terminal; pass -y to confirm"
        printf "type 'yes' to continue: "
        read -r answer
        [ "$answer" = yes ] || die "cancelled"
    fi
    for id in $list; do
        docker rm -f "$(cname "$id")" >/dev/null
    done
    for v in $vols; do
        docker volume rm "$v" >/dev/null
    done
    cmd_hostd stop
    rm -rf "$statedir" "$rundir"
    rmdir "${statedir%/*}" 2>/dev/null || true
    [ "$config" = 0 ] || rm -rf "$confdir"
    if [ "$images" = 1 ]; then
        for img in "$image" "$core_image"; do
            docker image inspect "$img" >/dev/null 2>&1 || continue
            if [ -n "$(docker ps -aq --filter "ancestor=$img")" ]; then
                echo "raven: kept $img: other sessions use it" >&2
            else
                docker image rm "$img" >/dev/null
            fi
        done
    fi
    echo "raven: removed. Session backups stay in $backupdir; delete them yourself if unwanted." >&2
    echo "raven: left to do by hand: rm ~/.local/bin/raven and the checkout;" \
        "chmod g-ws ~/Downloads undoes the shared-group setting" >&2
}

cmd_hostd() {
    local pid
    case "${1:-status}" in
        status)
            pid=$(hostd_pid)
            if [ -n "$pid" ]; then
                echo "running (pid $pid), log: $rundir/hostd.log"
            else
                echo "not running"
            fi ;;
        start)
            ensure_hostd && echo "running (pid $(hostd_pid))" ;;
        stop)
            pid=$(hostd_pid)
            [ -z "$pid" ] || kill "$pid" ;;
        *) die "usage: raven hostd [status | start | stop]" ;;
    esac
}

[ $# -gt 0 ] || { cmd_new; exit; }
case "$1" in
    -h | --help | help) usage ;;
    -*) cmd_new "$@" ;;
    new) shift; cmd_new "$@" ;;
    attach | a) shift; cmd_attach "$@" ;;
    ls | list) shift; cmd_ls "$@" ;;
    limit) shift; cmd_limit "$@" ;;
    rename) shift; cmd_rename "$@" ;;
    run) shift; cmd_run "$@" ;;
    shell) shift; cmd_shell "$@" ;;
    kill) shift; cmd_kill "$@" ;;
    pause) shift; cmd_pause "$@" ;;
    resume) shift; cmd_resume "$@" ;;
    recreate) shift; cmd_recreate "$@" ;;
    backup) shift; cmd_backup "$@" ;;
    restore) shift; cmd_restore "$@" ;;
    build) shift; cmd_build "$@" ;;
    addon) shift; cmd_addon "$@" ;;
    menu) shift; cmd_menu "$@" ;;
    home) shift; cmd_home "$@" ;;
    hostd) shift; cmd_hostd "$@" ;;
    web) shift; exec python3 "$srcdir/raven-web" "$@" ;;
    wallpaper) shift; cmd_wallpaper "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    *) usage >&2; exit 2 ;;
esac
