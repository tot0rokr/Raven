#!/bin/sh
set -eu

: "${RAVEN_DISPLAY:?}"
: "${RAVEN_PORT:?}"
: "${RAVEN_GEOMETRY:=1600x900}"
: "${RAVEN_TITLE:=raven}"
: "${RAVEN_CMD:=}"
: "${RAVEN_WM:=openbox}"

# Files in the shared ~/Downloads stay writable for the host user's group
umask 002

case "$RAVEN_WM" in
    openbox) wm_cmd=openbox-session ;;
    xmonad) wm_cmd=xmonad-x86_64-linux ;;
    *) echo "unknown RAVEN_WM: $RAVEN_WM" >&2; exit 1 ;;
esac
export RAVEN_WM

# Ubuntu's bash.bashrc runs groups(1) for its sudo hint unless this file exists; the host
# group added with --group-add has no name here, so groups would print an error in every shell
[ -e "$HOME/.hushlogin" ] || : > "$HOME/.hushlogin"

mkdir -p "$HOME/.vnc"
chmod 700 "$HOME/.vnc"
head -c 32 /dev/urandom | base64 | head -c 8 | vncpasswd -f > "$HOME/.vnc/passwd"
chmod 600 "$HOME/.vnc/passwd"

# The X socket is reachable from the host netns, so require a cookie
export XAUTHORITY="$HOME/.Xauthority"
rm -f "$XAUTHORITY"
xauth -q add ":$RAVEN_DISPLAY" . "$(mcookie)"

# The container filesystem survives restarts, so drop the previous run's lock
rm -f "/tmp/.X$RAVEN_DISPLAY-lock" "/tmp/.X11-unix/X$RAVEN_DISPLAY"

# MIT-SHM is off: host apps (run --host) live in another IPC namespace, and
# Mesa draws nothing when its SysV segment cannot be attached by this server
Xvnc ":$RAVEN_DISPLAY" -auth "$XAUTHORITY" -geometry "$RAVEN_GEOMETRY" -depth 24 \
    -desktop "$RAVEN_TITLE" -rfbport "$RAVEN_PORT" -localhost -nolisten tcp \
    -extension MIT-SHM \
    -SecurityTypes VncAuth -PasswordFile "$HOME/.vnc/passwd" &
xvnc=$!

i=0
until [ -S "/tmp/.X11-unix/X$RAVEN_DISPLAY" ]; do
    i=$((i + 1))
    [ "$i" -le 50 ] || { echo "Xvnc did not start" >&2; exit 1; }
    sleep 0.2
done

export DISPLAY=":$RAVEN_DISPLAY"
xrdb -merge /etc/raven/Xresources

# Session bus at the image's fixed address; --fork returns once it accepts connections.
# Started after DISPLAY so services it activates can reach the screen.
bus=${DBUS_SESSION_BUS_ADDRESS#unix:path=}
rm -rf "${bus%/*}"
mkdir -m 700 "${bus%/*}"
dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --nopidfile \
    || echo "dbus-daemon did not start; continuing without a session bus" >&2

# Addon daemons such as an input method must be up before the apps that connect to them
raven-session-hooks start
raven-wallpaper >/dev/null 2>&1 &

# Let apps exit cleanly before their display goes away
stop() {
    for p in /proc/[0-9]*; do
        pid=${p#/proc/}
        case "$pid" in
            1 | $$ | "$xvnc") ;;
            *) kill -TERM "$pid" 2>/dev/null || true ;;
        esac
    done
    sleep 2
    kill -TERM "$xvnc" 2>/dev/null || true
    exit 0
}
trap stop TERM INT

$wm_cmd &
wm=$!

[ -z "$RAVEN_CMD" ] || sh -c "$RAVEN_CMD" &

# Keep a window manager for as long as the display lives
while :; do
    wait "$wm" || true
    kill -0 "$xvnc" 2>/dev/null || exit 1
    sleep 1
    $wm_cmd &
    wm=$!
done
