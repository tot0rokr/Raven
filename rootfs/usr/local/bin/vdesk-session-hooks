#!/bin/sh
# Run the session hooks that addons put in /etc/vdesk/session.d, in name order.
#   start   the display is up; the window manager and session command come next
#   reload  vdesk copied changed files from ~/.config/vdesk/home into the session home
# A hook starts its own daemons in the background and returns.
set -u
for h in /etc/vdesk/session.d/*; do
    [ -f "$h" ] || continue
    sh "$h" "$1" || echo "vdesk-session-hooks: $h $1 failed" >&2
done
exit 0
